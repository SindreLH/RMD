<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>7392d91d-074f-4e51-8f02-7291108cf1aa</UserSecretsId>
  </PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\images\" />
    <Folder Include="wwwroot\fonts\" />
  </ItemGroup>

	<!--EFC Versions were set to 6.0.12 here-->

	<ItemGroup>
	    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.2">
		    <PrivateAssets>all</PrivateAssets>
		</PackageReference>
	     <PackageReference Include="Blazor-ApexCharts" Version="6.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.7.1" />
  </ItemGroup>

	<!--Added project reference to Business project
	
	Project dependencies flow like this: 
	GUI depends on BUSINESS
	BUSINESS depends on DATA
	DATA depends on NOTHING
	-->
	
	<ItemGroup>
		<ProjectReference Include="..\RMD.Business\RMD.Business.csproj" />
	</ItemGroup>
	
	<ItemGroup>
	  <Content Update="wwwroot\fonts\Roboto-Regular.ttf">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>

</Project>