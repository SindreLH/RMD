@using RMD.Business.Services;
@inject NavigationManager Nav
@inject HttpClient Http

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">

        <a class="navbar-brand" href="/dashboard">
            <img src="images/rmd_logo.png" width="130" height="50"/>
        </a>

        <button title="Navigation menu" class="navbar-toggler">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div>
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="Dashboard" Match="NavLinkMatch.All">
                <span class="oi oi-pie-chart" aria-hidden="true"></span> Dashboard
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="Register">
                <span class="oi oi-plus" aria-hidden="true"></span> Legg til
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="Archive">
                <span class="oi oi-box" aria-hidden="true"></span> Arkiv
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="Mixtapes">
                <span class="oi oi-headphones" aria-hidden="true"></span> Mixtapes
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="Mixtapes">
                <span class="oi oi-cog" aria-hidden="true"></span> Innstillinger
            </NavLink>
        </div>

        <form method="post" action="/auth/logout" class="nav-item px-3">
            <button 
                style="background:#1b1c1d; 
                       color:#d7d7d7;
                       border: none;
                       border-radius:4px;
                       margin-top: -20px;
                       width:100%;
                       height:3rem;
                       display:flex;
                       align-items:center;
                       cursor:pointer;"
                       onmouseenter="
                            this.style.background='rgba(255,255,255,0.1)';
                            this.style.color='#ffffff';"
                       onmouseleave="this.style.background='#1b1c1d';
                                     this.style.color='#d7d7d7';">
                <span class="oi oi-key"></span>
                <span class="logout_text">Logg ut</span>
            </button>
        </form>
    </nav>
</div>

