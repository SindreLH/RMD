@inherits LayoutComponentBase
@using RMD.GUI.Pages.Components.Toasts;
@inject IJSRuntime JS

<div class="auth_layout">
    @* The video source is set by wwwroot/js/rmd.js on larger screens only; phones keep the still image *@
    <video @ref="bgVideo" class="bg_video" muted loop playsinline preload="none"
           poster="images/login-bg-poster.jpg" aria-hidden="true"></video>
    <header class="auth_header">
        <img class="rmd_logo" src="images/rmd_logo.png" width="130" height="50" alt="RMD">
    </header>
    <ToastComponent />
    <main class="auth_content">@Body</main>
</div>

@code {
    private ElementReference bgVideo;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            await JS.InvokeVoidAsync("rmd.startBackgroundVideo", bgVideo, "video/login-bg.mp4");
        }
        catch (JSDisconnectedException)
        {
            // The circuit closed (e.g. the login form posted): nothing to start
        }
    }
}
