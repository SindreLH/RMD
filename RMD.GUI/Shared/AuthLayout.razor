@inherits LayoutComponentBase
@using RMD.GUI.Pages.Components.Toasts;

<div class="auth_layout">
    <video class="bg_video"
           autoplay
           muted
           loop
           playsinline
           aria-hidden="true">
        <source src="video/video_bg_login_3.mp4" type="video/mp4" />
    </video>

    <header class="auth_header">
        <img class="rmd_logo" src="images/rmd_logo.png" width="130" height="50" alt="RMD">
    </header>

    <ToastComponent />

    <main class="auth_content">
        @Body
    </main>
</div>
