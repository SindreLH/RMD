@inherits LayoutComponentBase
@using RMD.GUI.Pages.Components.Toasts

<PageTitle>RMD.GUI</PageTitle>

<div class="page">
    <div class="sidebar">
        <AuthorizeView>
            <Authorized>

                <NavMenu />

                <div class="auth_state_container">

                    <img src="images/creator.png" class="user_pic" />

                    <div class="auth_text">
                        <div class="admin_title_container">
                            <p style="font-size: 0.9rem;"> Sindre</p>
                        </div>
                        <p style="font-size: 0.7rem;">Admin</p>
                    </div>

                </div>


            </Authorized>
        </AuthorizeView>
    </div>

    <main>
        <article class="content px-4">
            @* An exception in a page shows this message instead of killing the whole session *@
            <ErrorBoundary @ref="errorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <div class="alert alert-danger mt-4" role="alert">
                        <h4>Noe gikk galt</h4>
                        <p>Siden kunne ikke vises. Prøv igjen, eller gå til en annen side.</p>
                        <button type="button" class="btn btn-outline-light" @onclick="() => errorBoundary?.Recover()">Prøv igjen</button>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </article>
    </main>

     <ToastComponent />
</div>

@code{
    private ErrorBoundary? errorBoundary;

    // Navigating to another page clears a previous error
    protected override void OnParametersSet()
    {
        errorBoundary?.Recover();
    }
}
