@using RMD.GUI.Infrastructure
<CascadingValue Name="AntiforgeryToken" Value="AntiforgeryToken">
<CascadingValue Value="ThemeCatalog.Get(Theme)">
<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData"
                            DefaultLayout="@typeof(MainLayout)">
            <NotAuthorized>
                <RedirectToLogin IsAuthenticated="@(context.User.Identity?.IsAuthenticated == true)" />
            </NotAuthorized>

            <Authorizing>
                <p>Checking permissions...</p>
            </Authorizing>

        </AuthorizeRouteView>
    </Found>


    <NotFound>
        <LayoutView Layout="@typeof(AuthLayout)">

            <RMD.GUI.Pages.NotFound/>

        </LayoutView>
    </NotFound>
</Router>
</CascadingValue>
</CascadingValue>

@code {
    /// <summary>Request token generated in _Host.cshtml, consumed by AntiforgeryInput.</summary>
    [Parameter] public string? AntiforgeryToken { get; set; }

    /// <summary>Active theme id from the rmd-theme cookie (read in _Host.cshtml).</summary>
    [Parameter] public string? Theme { get; set; }
}
