@page "/Register"
@attribute [Authorize]

@* The selected tab is in the URL (?tab=song) so it survives reloads and can be bookmarked *@

<div class="rmd-page">
	<nav aria-label="Legg til">
		<ul class="rmd-tabs">
			<li><a href="/Register" class="@(ShowSong ? "" : "active")">Legg til artist</a></li>
			<li><a href="/Register?tab=song" class="@(ShowSong ? "active" : "")">Legg til låt</a></li>
		</ul>
	</nav>

	@if (ShowSong)
	{
		<RegisterSong />
	}
	else
	{
		<RegisterArtist />
	}
</div>

@code {
	[SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }

	private bool ShowSong => string.Equals(Tab, "song", StringComparison.OrdinalIgnoreCase);
}
