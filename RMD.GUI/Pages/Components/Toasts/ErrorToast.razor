@page "/Test4"

<div class="toast_container">

	<!--Error toast - general errors-->
	<div class="toast_contents_error">
		<i class="bi bi-x-circle-fill"></i>
		<p>Feil:</p>
		@if (showDataFetchToast)
		{
			<p>Kunne ikke hente ut data. Vennligst prøv igjen.</p>
		}

		@if(showDataSavingToast)
		{
			<p>Kunne ikke lagre data. Vennligst prøv igjen.</p>
		}

		@if (showDataDeleteToast)
		{
			<p>Kunne ikke slette data. Vennligst prøv igjen.</p>
		}

		@if (showGeneralErrorToast)
		{
			<p>En ukjent feil har oppstått. Vennligst prøv igjen.</p>
		}

		
		
		<i class="bi bi-x"></i>
	</div>
</div>

@code {



	private bool showDataFetchToast = true;
	private bool showDataSavingToast = false;
	private bool showDataDeleteToast = false;
	private bool showGeneralErrorToast = false;
}
