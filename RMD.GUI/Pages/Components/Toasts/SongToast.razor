@page "/Test"

@* Change name to SUCCESS TOAST: *@

@if (ShowToast)
{
	<div class="toast_container">
		<div class="toast_contents_success">

			<i class="bi bi-check-circle-fill"></i>

			<div class="text_container">
				<p class="text-truncate" style="max-width:350px; height: 100%;">@ToastMessage</p>
			</div>
			<i class="bi bi-x" @onclick="Close"></i>

		</div>
	</div>
}


@code {
	[Parameter] public bool ShowToast { get; set; }
	[Parameter] public string ToastMessage { get; set; } = string.Empty;
	[Parameter] public EventCallback OnClose { get; set; }

	private async Task Close()
	{
		if (OnClose.HasDelegate)
		{
			await OnClose.InvokeAsync();
		}
	}

}
