
@if (ShowWarningToast)
{
	<div class="toast_container">
		<div class="toast_contents">

			<i class="bi bi-exclamation-triangle-fill"></i>

			<div class="text_container">
				<p class="text-truncate" style="max-width:350px; height: 100%;">@WarningToastMessage</p>
			</div>
			<i class="bi bi-x" @onclick="Close"></i>

		</div>
	</div>
}


@code {
	[Parameter] public bool ShowWarningToast { get; set; }
	[Parameter] public string WarningToastMessage { get; set; } = string.Empty;
	[Parameter] public EventCallback OnClose { get; set; }

	private async Task Close()
	{
		if (OnClose.HasDelegate)
		{
			await OnClose.InvokeAsync();
		}
	}

}

