@* The genre <option> list shared by the song forms. *@
@* Rendered inline (not as a child component) so a bound <select> keeps its value: Blazor sets
   the select's value together with its options only when they are part of the same element. *@

@code {
    public static readonly RenderFragment Options =
    @<text>
        <option value="" style="color: var(--rmd-option-placeholder);">Velg en sjanger</option>
        <option value="Hands Up">Hands Up</option>
        <option value="Hardstyle">Hardstyle</option>
        <option value="House">House</option>
        <option value="Trance">Trance</option>
        <option value="Happy Hardcore">Happy Hardcore</option>
    </text>;
}
