@using RMD.Data.Models
@using RMD.Data.Models.DTO
@using RMD.Business.Services
@using RMD.GUI.Pages.Components.Toasts

@inject ToastService ToastService
@inject IArtistService ArtistService

<ModalShell Title="Rediger låt" Icon="bi-pencil-square" Width="44rem" CloseOnBackdrop="false" OnClose="CloseEditModal">
	<ChildContent>
		<EditForm id="@formId" Model="editable" OnValidSubmit="SaveChangesAsync">
			<DataAnnotationsValidator />

			<div class="rmd-form-grid">
				<div class="rmd-fieldset">
					<div class="rmd-field">
						<label for="edit-title">Tittel</label>
						<InputText id="edit-title" class="form-control" @bind-Value="editable.Title" />
						<ValidationMessage For="@(() => editable.Title)" />
					</div>

					<div class="rmd-field">
						<label for="edit-length">Lengde (MM:SS)</label>
						<InputText id="edit-length" class="form-control" placeholder="03:45" @bind-Value="editable.Length" />
						<ValidationMessage For="@(() => editable.Length)" />
					</div>

					<div class="rmd-field">
						<label for="edit-genre">Sjanger</label>
						<select id="edit-genre" class="form-control" @bind="editable.Genre">
							@GenreOptions.Options
						</select>
						<ValidationMessage For="@(() => editable.Genre)" />
					</div>

					<ArtistPicker Label="Artister" Artists="allArtists" Rows="artistRows" />

					@if (remixIsToggled)
					{
						<ArtistPicker Label="Remix artister" Placeholder="Velg remixartist" Artists="allArtists" Rows="remixRows" />
					}
				</div>

				<div class="rmd-fieldset">
					<div class="form-check form-switch rmd-switch">
						<input class="form-check-input" type="checkbox" id="edit-remix" @bind="remixIsToggled">
						<label class="form-check-label" for="edit-remix">Remix</label>
						<small>Aktiver artistvalg for remixartist.</small>
					</div>

					<div class="form-check form-switch rmd-switch">
						<input class="form-check-input" type="checkbox" id="edit-extended" @bind="editable.ExtendedMix">
						<label class="form-check-label" for="edit-extended">Extended Mix</label>
						<small>Mix med intro og outro.</small>
					</div>

					<div class="form-check form-switch rmd-switch">
						<input class="form-check-input" type="checkbox" id="edit-favorite" @bind="editable.Favorite" />
						<label class="form-check-label" for="edit-favorite">Favoritt</label>
						<small>Låten har favorittstatus.</small>
					</div>

					<div class="form-check form-switch rmd-switch">
						<input class="form-check-input" type="checkbox" id="edit-played" @bind="editable.Played">
						<label class="form-check-label" for="edit-played">Spilt</label>
						<small>Låten er spilt i en tidligere mixtape.</small>
					</div>

					@if (editable.Played)
					{
						<div class="rmd-field">
							<label for="edit-ep">Mixtape vol.</label>
							<input id="edit-ep" type="number" min="0" class="form-control" @bind="editable.PlayedInEp" />
						</div>
					}

					<div class="form-check form-switch rmd-switch">
						<input class="form-check-input" type="checkbox" id="edit-stored" @bind="editable.Stored">
						<label class="form-check-label" for="edit-stored">Lagret</label>
						<small>Låten er lagret i samlingen.</small>
					</div>

					<div class="form-check form-switch rmd-switch">
						<input class="form-check-input" type="checkbox" id="edit-wanted" @bind="editable.Wanted">
						<label class="form-check-label" for="edit-wanted">Ønsket</label>
						<small>Låten er ønsket og må skaffes.</small>
					</div>

					@if (editable.Wanted)
					{
						<div class="rmd-field">
							<label for="edit-url">Låtkilde (URL)</label>
							<input id="edit-url" type="url" class="form-control" @bind="editable.WantedSongUrl" />
						</div>
					}
				</div>
			</div>
		</EditForm>
	</ChildContent>
	<Footer>
		<button type="button" class="btn btn-secondary" @onclick="CloseEditModal">
			Avbryt
		</button>
		<button type="submit" form="@formId" class="btn btn-success" disabled="@isSaving">
			@(isSaving ? "Lagrer..." : "Lagre endringer")
		</button>
	</Footer>
</ModalShell>


@code {
	private const string formId = "edit-song-form";

	private List<Artist>? allArtists;
	private bool remixIsToggled = false;
	private int currentSongId;
	private bool isSaving;

	[Parameter] public bool IsVisible { get; set; }
	[Parameter] public EventCallback<bool> OnClose { get; set; }
	/// <summary>The parent saves, shows the result toast and closes the modal on success.</summary>
	[Parameter] public EventCallback<SongUpdateDto> OnSave { get; set; }
	[Parameter] public Song? Song { get; set; }

	private List<ArtistPickerRow> artistRows = new() { new ArtistPickerRow() };
	private List<ArtistPickerRow> remixRows = new() { new ArtistPickerRow() };
	private SongUpdateDto editable = new();

	protected override async Task OnInitializedAsync()
	{
		var result = await ArtistService.GetAllArtistsAsync();
		allArtists = result.IsSuccess ? result.Value.OrderBy(a => a.Name).ToList() : new();
	}

	protected override void OnParametersSet()
	{
		if (Song is not null && Song.SongId != currentSongId)
		{
			currentSongId = Song.SongId;

			// Map data til editable DTO
			editable = new SongUpdateDto
			{
				SongId = Song.SongId,
				Title = Song.Title,
				Length = Song.Length,
				Genre = Song.Genre,
				Favorite = Song.Favorite,
				ExtendedMix = Song.ExtendedMix,
				RadioMix = Song.RadioMix,
				Played = Song.Played,
				PlayedInEp = Song.PlayedInEp,
				Stored = Song.Stored,
				Wanted = Song.Wanted,
				WantedSongUrl = Song.WantedSongUrl,
				// VIKTIG: Sørg for at Song.SongArtists faktisk er lastet fra databasen
				ArtistIds = Song.SongArtists?.Where(x => x.Role == ArtistRole.Primary).Select(x => x.ArtistId).ToList() ?? new(),
				RemixArtistIds = Song.SongArtists?.Where(x => x.Role == ArtistRole.Remix).Select(x => x.ArtistId).ToList() ?? new()
			};

			artistRows = ArtistPicker.RowsFor(editable.ArtistIds);
			remixRows = ArtistPicker.RowsFor(editable.RemixArtistIds);
			remixIsToggled = editable.RemixArtistIds.Any();
		}
	}

	private async Task SaveChangesAsync()
	{
		editable.ArtistIds = ArtistPicker.SelectedIds(artistRows);

		// Turning the Remix switch off removes the remix artists
		editable.RemixArtistIds = remixIsToggled ? ArtistPicker.SelectedIds(remixRows) : new();

		if (editable.ArtistIds.Count == 0)
		{
			ToastService.ShowToast("ADVARSEL: Velg minst én artist.", ToastType.Warning);
			return;
		}

		isSaving = true;
		try
		{
			await OnSave.InvokeAsync(editable);
		}
		finally
		{
			isSaving = false;
		}
	}

	private Task CloseEditModal() => OnClose.InvokeAsync(false);
}
