@page "/Modal6"
@using RMD.Data.Models
@using RMD.Data.Models.DTO
@using RMD.Business.Services

@inject IArtistService ArtistService

@if (IsVisible)
{
    <div class="modal-backdrop">
        <div class="container_parent">
            <div class="main_form_container">

                <i class="bi bi-pencil-square"></i>

                <h3>Rediger artist</h3>

                @if(editableArtist != null)
                {
                    <form id="reg_artist_form">
                        <div class="artist_information">

                            <div class="info_child">
                                <label for="artistName">Navn</label>
                                <input type="text" class="form-control" @bind="editableArtist.Name" />
                            </div>

                            <div class="info_child">
                                <label for="artistNationality">Land </label>
                                <InputSelect @bind-Value="editableArtist.Nationality" class="form-control">
