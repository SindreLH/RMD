@using RMD.Data.Models
@using RMD.Business.Services
@using RMD.GUI.Pages.Components.Toasts

@inject ToastService ToastService
@inject IArtistService ArtistService

@if (IsVisible && editableArtist != null)
{
    <ModalShell Title="Rediger artist" Icon="bi-pencil-square" Width="42rem" CloseOnBackdrop="false" OnClose="CloseEditModal">
        <ChildContent>
            @* EditForm is required: InputSelect throws without a cascading EditContext *@
            <EditForm id="@formId" Model="editableArtist" OnValidSubmit="SaveChangesAsync">
                <DataAnnotationsValidator />

                <div class="rmd-artist-form">
                    <div class="rmd-artist-form__row">
                        <div class="rmd-field">
                            <label for="artistName">Navn</label>
                            <InputText id="artistName" class="form-control" @bind-Value="editableArtist.Name" />
                            <ValidationMessage For="@(() => editableArtist.Name)" />
                        </div>

                        <div class="rmd-field">
                            <label for="artistNationality">Land</label>
                            <InputSelect id="artistNationality" @bind-Value="editableArtist.Nationality" class="form-control">
                                @NationalityOptions.Options
                            </InputSelect>
                        </div>
                    </div>

                    <div class="rmd-field">
                        <label for="artistFacebook">Facebook</label>
                        <input id="artistFacebook" type="url" class="form-control" @bind="editableArtist.FacebookUrl" />
                    </div>

                    <div class="rmd-field">
                        <label for="artistSoundcloud">Soundcloud</label>
                        <input id="artistSoundcloud" type="url" class="form-control" @bind="editableArtist.SoundcloudUrl" />
                    </div>

                    <div class="rmd-field">
                        <label for="profilePicture">Profilbilde</label>
                        <input id="profilePicture" type="url" class="form-control" @bind="editableArtist.ProfilePicUrl" />
                    </div>

                    <div class="rmd-field">
                        <label for="artistDiscogs">Discogs</label>
                        <input id="artistDiscogs" type="url" class="form-control" @bind="editableArtist.DiscogsUrl" />
                    </div>

                    @if (allArtists != null)
                    {
                        <AliasPicker Artists="allArtists" ArtistId="editableArtist.ArtistId" AliasGroupId="Artist?.AliasGroupId" Selected="aliasIds" />
                    }
                </div>
            </EditForm>
        </ChildContent>
        <Footer>
            <button type="button" @onclick="CloseEditModal" class="btn btn-secondary">
                Avbryt
            </button>
            <button type="submit" form="@formId" class="btn btn-success" disabled="@isSaving">
                @(isSaving ? "Lagrer..." : "Lagre endringer")
            </button>
        </Footer>
    </ModalShell>
}


@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback<bool> OnClose { get; set; }
    /// <summary>The parent saves (artist and aliases), shows the result toast and closes the modal on success.</summary>
    [Parameter] public EventCallback<ArtistEdit> OnSave { get; set; }
    [Parameter] public Artist? Artist { get; set; }
    /// <summary>The artist's current aliases.</summary>
    [Parameter] public IReadOnlyList<Artist> Aliases { get; set; } = Array.Empty<Artist>();

    /// <summary>What the modal hands back on save.</summary>
    public sealed record ArtistEdit(Artist Artist, List<int> AliasIds);

    private List<Artist>? allArtists;
    private List<int> aliasIds = new();

    private const string formId = "edit-artist-form";
    private Artist? editableArtist;
    private int editingArtistId;
    private bool isSaving;

    private void CloseEditModal()
    {
        OnClose.InvokeAsync(false);

        // Truncating long artist names
        var name = editableArtist?.Name.Length > 10
            ? editableArtist.Name[..10] + "..."
            : editableArtist?.Name;

        ToastService.ShowToast($"INFO: Endringene på {name} ble avbrutt.", ToastType.Info);
    }

    private async Task SaveChangesAsync()
    {
        if (editableArtist == null || isSaving)
            return;

        isSaving = true;
        try
        {
            await OnSave.InvokeAsync(new ArtistEdit(editableArtist, aliasIds.ToList()));
        }
        finally
        {
            isSaving = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var result = await ArtistService.GetAllArtistsAsync();
        allArtists = result.IsSuccess ? result.Value.ToList() : new();
    }

    protected override void OnParametersSet()
    {
        // Only copy when a different artist is passed in, so a parent re-render doesn't wipe the user's edits
        if (Artist != null && Artist.ArtistId != editingArtistId)
        {
            editingArtistId = Artist.ArtistId;
            aliasIds = Aliases.Select(a => a.ArtistId).ToList();
            editableArtist = new Artist
                {
                    ArtistId = Artist.ArtistId,
                    Name = Artist.Name,
                    Nationality = Artist.Nationality,
                    FacebookUrl = Artist.FacebookUrl,
                    SoundcloudUrl = Artist.SoundcloudUrl,
                    DiscogsUrl = Artist.DiscogsUrl,
                    ProfilePicUrl = Artist.ProfilePicUrl
                };
        }
    }
}
