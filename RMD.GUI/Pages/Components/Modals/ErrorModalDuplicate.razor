@page "/Modal4"
@using RMD.Business.Services
@inject IArtistService ArtistService
@inject ISongService SongService

@if (IsVisible)
{
	<div class="modal-backdrop">
		<div class="parent_container">
			<div class="main_container">

				<i class="bi bi-exclamation-triangle"></i>

				<h3>Feilmelding</h3>
				<h4>Duplikat</h4>

				<div class="text_container">
					<p>Du prøver å legge til et duplikat.</p>
					<p><strong>@ArtistName </strong> - <strong>@Title</strong> finnes allerede i databasen.</p>
				</div>


				<div class="close_button">
					<button type="button" class="btn btn-secondary" @onclick="CloseDuplicateEntryModal">
						Lukk
					</button>
				</div>
			</div>

		</div>
	</div>

}




@code {
	[Parameter] public bool IsVisible { get; set; }
	[Parameter] public EventCallback<bool> OnClose { get; set; }

	[Parameter] public string? Title { get; set; }
	[Parameter] public string? ArtistName { get; set; }

	private void CloseDuplicateEntryModal()
	{
		OnClose.InvokeAsync(true);
	}
}
