@if (IsVisible)
{
	<ModalShell Title="Advarsel" Subtitle="Ingen data" Icon="bi-exclamation-triangle" OnClose="CloseEmptyDbModal">
		<ChildContent>
			<div class="text-center">
				<p>Databasen er tom.</p>
				<p>Legg til en artist eller låt for å komme i gang.</p>
			</div>
		</ChildContent>
		<Footer>
			<a href="/Register" class="btn btn-success">Legg til</a>
			<button type="button" class="btn btn-secondary" @onclick="CloseEmptyDbModal">
				Lukk
			</button>
		</Footer>
	</ModalShell>
}

@code {
	[Parameter] public bool IsVisible { get; set; }
	[Parameter] public EventCallback<bool> OnClose { get; set; }

	private Task CloseEmptyDbModal() => OnClose.InvokeAsync(false);
}
