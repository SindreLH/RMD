@page "/Modal1"
@using RMD.Data.Models
@using RMD.Business.Services
@using RMD.GUI.Pages.Components.Toasts

@inject ToastService ToastService

@if (IsVisible)
{
	<div class="modal-backdrop">
		<div class="parent_container">
			<div class="main_container">

				<i class="bi bi-exclamation-triangle"></i>

				<h3>Advarsel</h3>
				<h4>Sletting</h4>

				<div class="text_container">
					<p>Ønsker du å slette <strong>"@Song?.Title" av @Song?.Artists</strong> fra databasen?</p>
					<p>Handlingen kan ikke angres.</p>
				</div>

				<div class="button_container">
					<div class="cancel_button">
						<button type="button" class="btn btn-secondary" @onclick="CloseDeleteModal">
							Avbryt
						</button>
					</div>

					<div class="delete_button">
						<button type="button" class="btn btn-danger" @onclick="DeleteSong">
							Slett låt
						</button>
					</div>
				</div>
			</div>
		</div>
	</div>
}



@code {
	[Parameter] public bool IsVisible { get; set; }
	[Parameter] public EventCallback<bool> OnClose { get; set; }
	[Parameter] public EventCallback<Song> OnDelete { get; set; }
	[Parameter] public Song? Song { get; set; }

	private void CloseDeleteModal()
	{
		OnClose.InvokeAsync(false);

		// Truncating long song titles
		var title = Song?.Title.Length > 20
			? Song?.Title[..20] + "..."
			: Song?.Title;
		ToastService.ShowToast($"INFO: {title} ble ikke fjernet.", ToastType.Info);
	}

	private void DeleteSong()
	{
		OnDelete.InvokeAsync(Song);

		// Truncating long song titles
		var title = Song?.Title.Length > 20
			? Song?.Title[..20] + "..."
			: Song?.Title;
		
		ToastService.ShowToast($"SUKSESS! {title} ble fjernet.", ToastType.Success);
	}
 }


