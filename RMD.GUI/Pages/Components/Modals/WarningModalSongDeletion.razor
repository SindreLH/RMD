
@using RMD.Data.Models
@using RMD.Business.Services

@if (IsVisible)
{
	<div class="modal-backdrop">
		<div class="parent_container">
			<div class="main_container">

				<i class="bi bi-exclamation-triangle"></i>

				<h3>Advarsel</h3>
				<h4>Sletting</h4>

				<p class="text_container">
				Ønsker du virkelig å slette
				<strong>
				@string.Join(", ", Song?.SongArtists? .Where(sa => sa.Role == ArtistRole.Primary && sa.Artist != null).Select(sa => sa.Artist!.Name) ?? Enumerable.Empty<string>()) - <strong>"@Song?.Title" ?</strong>
				</strong>
			</p>

				<div class="button_container">
					<div class="cancel_button">
						<button type="button" class="btn btn-secondary" @onclick="CloseDeleteModal">
							Avbryt
						</button>
					</div>

					<div class="delete_button">
						<button type="button" class="btn btn-danger" @onclick="DeleteSong" disabled="@isDeleting">
							@(isDeleting ? "Sletter..." : "Slett låt")
						</button>
					</div>
				</div>
			</div>
		</div>
	</div>
}



@code {
	[Parameter] public bool IsVisible { get; set; }
	[Parameter] public EventCallback<bool> OnClose { get; set; }
	/// <summary>The parent deletes, shows the result toast and closes the modal.</summary>
	[Parameter] public EventCallback<Song> OnDelete { get; set; }
	[Parameter] public Song? Song { get; set; }

	private bool isDeleting;

	private void CloseDeleteModal()
	{
		OnClose.InvokeAsync(false);
	}

	private async Task DeleteSong()
	{
		if (Song == null || isDeleting)
			return;

		isDeleting = true;
		try
		{
			await OnDelete.InvokeAsync(Song);
		}
		finally
		{
			isDeleting = false;
		}
	}
 }

