@using RMD.Data.Models
@using RMD.Business.Services

@if (IsVisible)
{
	<ModalShell Title="Advarsel" Subtitle="Sletting" Icon="bi-exclamation-triangle" OnClose="CloseDeleteModal">
		<ChildContent>
			<p class="text-center">
				Ønsker du virkelig å slette
				<strong>@ArtistNames - "@Song?.Title"</strong>?
			</p>
		</ChildContent>
		<Footer>
			<button type="button" class="btn btn-secondary" @onclick="CloseDeleteModal">
				Avbryt
			</button>
			<button type="button" class="btn btn-danger" @onclick="DeleteSong" disabled="@isDeleting">
				@(isDeleting ? "Sletter..." : "Slett låt")
			</button>
		</Footer>
	</ModalShell>
}

@code {
	[Parameter] public bool IsVisible { get; set; }
	[Parameter] public EventCallback<bool> OnClose { get; set; }
	/// <summary>The parent deletes, shows the result toast and closes the modal.</summary>
	[Parameter] public EventCallback<Song> OnDelete { get; set; }
	[Parameter] public Song? Song { get; set; }

	private bool isDeleting;

	private string ArtistNames => string.Join(", ", Song?.SongArtists
		.Where(sa => sa.Role == ArtistRole.Primary && sa.Artist != null)
		.Select(sa => sa.Artist!.Name) ?? Enumerable.Empty<string>());

	private Task CloseDeleteModal() => OnClose.InvokeAsync(false);

	private async Task DeleteSong()
	{
		if (Song == null || isDeleting)
			return;

		isDeleting = true;
		try
		{
			await OnDelete.InvokeAsync(Song);
		}
		finally
		{
			isDeleting = false;
		}
	}
}
