@page "/Modal2"
@using RMD.Data.Models
@using RMD.Business.Services
@using RMD.GUI.Pages.Components.Toasts

@inject ToastService ToastService

@if (IsVisible)
{
	<div class="modal-backdrop">
		<div class="parent_container">
			<div class="main_container">

				<i class="bi bi-exclamation-triangle"></i>

				<h3>Advarsel</h3>
				<h4>Sletting</h4>

				<div class="text_container">
					<p>Ønsker du virkelig å slette <strong>"@Artist?.Name"</strong> fra databasen?</p>
					<p>Handlingen kan ikke angres.</p>
				</div>

				<div class="button_container">
					<div class="cancel_button">
						<button type="button" class="btn btn-secondary" @onclick="CloseDeleteModal">
							Avbryt
						</button>
					</div>

					<div class="delete_button">
						<button type="button" class="btn btn-danger" @onclick="DeleteArtist">
							Slett artist
						</button>
					</div>
				</div>
			</div>
		</div>
	</div>
}



@code {
	[Parameter] public bool IsVisible { get; set; }
	[Parameter] public EventCallback<bool> OnClose { get; set; }
	[Parameter] public EventCallback<Artist> OnDelete { get; set; }
	[Parameter] public Artist? Artist { get; set; }

	private void CloseDeleteModal()
	{
		OnClose.InvokeAsync(false);

		// Truncating long song titles
		var name = Artist?.Name.Length > 30
			? Artist?.Name[..30] + "..."
			: Artist?.Name;
		ToastService.ShowToast($"INFO: Sletting av {name} ble avbrutt.", ToastType.Info);
		
	}

	private void DeleteArtist()
	{
		OnDelete.InvokeAsync(Artist);

		// Truncating long song titles
		var name = Artist?.Name.Length > 30
			? Artist?.Name[..30] + "..."
			: Artist?.Name;
		ToastService.ShowToast($"SUKSESS! {name} ble fjernet.", ToastType.Success);
	}
}


