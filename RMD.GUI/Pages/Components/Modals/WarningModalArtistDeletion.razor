@using RMD.Data.Models
@using RMD.Business.Services

@if (IsVisible)
{
	<ModalShell Title="Advarsel" Subtitle="Sletting" Icon="bi-exclamation-triangle" OnClose="CloseDeleteModal">
		<ChildContent>
			<div class="text-center">
				<p>Ønsker du virkelig å slette <strong>"@Artist?.Name"</strong> fra databasen?</p>
				@if (SongsLeftWithoutArtist > 0)
				{
					<p><strong>@SongsLeftWithoutArtist @(SongsLeftWithoutArtist == 1 ? "låt" : "låter")</strong> vil stå uten artist etter slettingen.</p>
				}
				<p>Handlingen kan ikke angres.</p>
			</div>
		</ChildContent>
		<Footer>
			<button type="button" class="btn btn-secondary" @onclick="CloseDeleteModal">
				Avbryt
			</button>
			<button type="button" class="btn btn-danger" @onclick="DeleteArtist" disabled="@isDeleting">
				@(isDeleting ? "Sletter..." : "Slett artist")
			</button>
		</Footer>
	</ModalShell>
}

@code {
	[Parameter] public bool IsVisible { get; set; }
	[Parameter] public EventCallback<bool> OnClose { get; set; }
	/// <summary>The parent deletes, shows the result toast and closes the modal.</summary>
	[Parameter] public EventCallback<Artist> OnDelete { get; set; }
	[Parameter] public Artist? Artist { get; set; }
	/// <summary>Songs whose only primary artist is this one (they keep existing, but without an artist).</summary>
	[Parameter] public int SongsLeftWithoutArtist { get; set; }

	private bool isDeleting;

	private Task CloseDeleteModal() => OnClose.InvokeAsync(false);

	private async Task DeleteArtist()
	{
		if (Artist == null || isDeleting)
			return;

		isDeleting = true;
		try
		{
			await OnDelete.InvokeAsync(Artist);
		}
		finally
		{
			isDeleting = false;
		}
	}
}
