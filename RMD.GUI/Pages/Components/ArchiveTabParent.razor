@page "/Archive"
@attribute [Authorize]

@* The selected tab is in the URL (?tab=songs) so it survives reloads and can be bookmarked *@

<div class="rmd-page">
	<nav aria-label="Arkiv">
		<ul class="rmd-tabs">
			<li><a href="/Archive" class="@(ShowSongs ? "" : "active")">Artister</a></li>
			<li><a href="/Archive?tab=songs" class="@(ShowSongs ? "active" : "")">Låter</a></li>
		</ul>
	</nav>

	@if (ShowSongs)
	{
		<SongListPage />
	}
	else
	{
		<ArtistListPage />
	}
</div>

@code {
	[SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }

	private bool ShowSongs => string.Equals(Tab, "songs", StringComparison.OrdinalIgnoreCase);
}
