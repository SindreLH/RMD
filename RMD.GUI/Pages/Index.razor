@page "/"
@using RMD.Business.Services
@using RMD.Data.Models
@inject IDashboardService DashboardService

<PageTitle>RMD | Home</PageTitle>

<div class="main_container">
	<div class="left_container">

		<div class="cards_container">
			<div class="data_card">
				<h3><strong>@songCount?.Value Låter</strong></h3>
				<p>188 Promoterte</p>
				<div class="newly_added">

					@if (isLoading)
					{
						<img src="~/images/Loader.gif">
					}

					@if (latestSong != null && latestSong.IsSuccess)
					{
						<p class="green_plus">+</p>
						<p>@latestSong.Value.Title Artister</p>
					}

					else
					{
						<p class="green_plus">+</p>
						<p>Ingen sanger funnet</p>
					}
				</div>
			</div>
			<div class="data_card">
				<h3><strong>@artistCount?.Value Artister</strong></h3>
				<p>34 Nasjonaliteter</p>
				<div class="newly_added">
					@if (isLoading)
					{
						<img src="~/images/Loader.gif">
					}

					@if (latestArtist != null && latestArtist.IsSuccess)
					{
						<p class="green_plus">+</p>
						<p>@latestArtist.Value.Name</p>
					}

					else
					{
						<p class="green_plus">+</p>
						<p>Ingen artister funnet</p>
					}
				</div>

			</div>
		</div>

		<div class="graphs_container">
			<div class="chart">
				<ApexChart TItem="MyData"
				Options = "ChartOptions">

					<ApexPointSeries TItem="MyData"
					Items="Data"
					Name="New Songs"
					SeriesType="SeriesType.Bar"
					XValue="e => e.Category"
					YValue="e => e.NewSongs" />

					<ApexPointSeries TItem="MyData"
					Items="Data"
					Name="New Artists"
					SeriesType="SeriesType.Bar"
					XValue="e => e.Category"
					YValue="e => e.NewArtists" />
				</ApexChart>
			</div>

			<div class="chart">
				<ApexChart TItem="PieChartData"
				Options="PieChartOptions">
					<ApexPointSeries TItem="PieChartData"
					Items="PieChartDataList"
					SeriesType="SeriesType.Pie"
					YValue="e => e.Value"
					XValue="e => e.Label" />
				</ApexChart>

			</div>

		</div>

		<div class="table_container">
			<table class="table table-bordered table-dark table-striped table-hover">
				<thead class="thead-light">
					<tr>
						<th>#</th>
						<th>Ext</th>
						<th>Tittel</th>
						<th>Kilde</th>
					</tr>
				</thead>
				<tbody>
					<tr>
						<td>1</td>
						<td>✅</td>
						<td>A New Song</td>
						<td>https://www.w3schools.com/html/html_tables.asp</td>
					</tr>
					<tr>
						<td>2</td>
						<td>✅</td>
						<td>Track Added Yesterday</td>
						<td>https://www.w3schools.com/html/html_tables.asp</td>
					</tr>
					<tr>
						<td>3</td>
						<td>✅</td>
						<td>I want This Song</td>
						<td>https://www.w3schools.com/html/html_tables.asp</td>
					</tr>
					<tr>
						<td>4</td>
						<td>✅</td>
						<td>Considering Buying This Track</td>
						<td>https://www.w3schools.com/html/html_tables.asp</td>
					</tr>
					<tr>
						<td>5</td>
						<td>❌</td>
						<td>This Track Is A Radio Edit</td>
						<td>https://www.w3schools.com/html/html_tables.asp</td>
					</tr>
					<tr>
						<td>6</td>
						<td>✅</td>
						<td>Got To Many Songs Man</td>
						<td>https://www.w3schools.com/html/html_tables.asp</td>
					</tr>
					<tr>
						<td>7</td>
						<td>✅</td>
						<td>Song 7</td>
						<td>https://www.w3schools.com/html/html_tables.asp</td>
					</tr>
					<tr>
						<td>7</td>
						<td>✅</td>
						<td>Song 7</td>
						<td>https://www.w3schools.com/html/html_tables.asp</td>
					</tr>
				</tbody>
			</table>
		</div>
	</div>

	<div class="right_container">

		<div class="resources_container">
			<h3 style="margin-left:3rem;">Ressurser</h3>
			<h5>ℹ️ Informasjon</h5>
			<div class="resource_item">
				<a href="https://www.discogs.com">🔗 Discogs.com</a>
			</div>
