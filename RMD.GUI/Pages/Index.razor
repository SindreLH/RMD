			<a href="https://nuteczki.eu/tags/hands+up" target="_blank" rel="noopener noreferrer">🔗 Nuteczki.eu Forums</a>
		</div>
	</aside>
</div>


@code {
	[CascadingParameter] private ThemeInfo Theme { get; set; } = ThemeCatalog.Get(null);

	private ApexChartOptions<BarChartData> ChartOptions { get; set; } = new();
	private List<BarChartData> Data { get; set; } = new();
	private ApexChartOptions<PieChartData> PieChartOptions { get; set; } = new();
	private List<PieChartData> PieChartDataList { get; set; } = new();
	private List<string> PieLabels = new();
	private List<double?> PieValues = new();

	private ApexChart<BarChartData>? barChart;
	private ApexChart<PieChartData>? pieChart;

	private Result<Song>? latestSong;
	private Result<Artist>? latestArtist;
	private Result<int>? artistCount;
	private Result<int>? songCount;
	private Result<int>? playedSongCount;
	private Result<int>? artistNationCount;
	private Result<IEnumerable<Song>>? wantedSongs;

	private bool isLoading = true;
	private bool showPieChart = true;

	protected override async Task OnInitializedAsync()
	{
		latestSong = await DashboardService.GetLatestSongAsync();
		latestArtist = await DashboardService.GetLatestArtistAsync();
		artistCount = await DashboardService.GetArtistCountAsync();
		songCount = await DashboardService.GetSongCountAsync();
		playedSongCount = await DashboardService.GetPlayedSongCountAsync();
		artistNationCount = await DashboardService.GetArtistNationCountAsync();
		wantedSongs = await DashboardService.GetWantedSongsAsync();

		//Load PieChart with data
		var genreCountsResult = await DashboardService.GetGenreCountAsync();
		if (genreCountsResult.IsSuccess && genreCountsResult.Value != null)
		{
			PieChartDataList.Clear();

			foreach (var kvp in genreCountsResult.Value)
			{
				PieChartDataList.Add(new PieChartData
				{
					Label = kvp.Key ?? "Ukjent sjanger",
					Value = kvp.Value,
					Count = kvp.Value
				});
			}

			var labels = PieChartDataList.Select(d => d.Label).ToList();

			PieChartOptions = new ApexChartOptions<PieChartData>
			{
				Labels = labels,

				Tooltip = new Tooltip
				{
					Custom = @"
				function({ series, seriesIndex, w }) {
					// The tooltip is inserted as HTML, so escape the genre name
					const label = String(w.globals.labels[seriesIndex]).replace(/[&<>""']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','""':'&quot;',""'"":'&#39;'}[c]));
					const count = series[seriesIndex];
					const total = series.reduce((a, b) => a + b, 0);
					const percentage = ((count / total) * 100).toFixed(1);
					return label + ': ' + count + ' låter (' + percentage + '%)';
				}"
				},

				Title = new Title
				{
					Text = "Sjangerfordeling",
					Style = new TitleStyle
					{
						Color = Theme.Chart.Text,
						FontFamily = "Franklin Gothic Medium, Arial Narrow, Arial, sans-serif",
						FontWeight = 500
					}
				},

				Chart = new Chart
				{
					Type = ChartType.Pie,
					Width = "100%",
					Height = 260
				},

				Legend = new Legend
				{
					Show = true,
					Position = LegendPosition.Bottom,
					FontFamily = "Franklin Gothic Medium, Arial Narrow, Arial, sans-serif",
					Labels = new LegendLabels
					{
						Colors = Theme.Chart.Text
					}
				},

				Stroke = new Stroke
				{
					Show = false,
					Width = new List<int> { 0 }
				}
			};
			ApplyThemeColors(PieChartOptions);
		}


		// Fixing an annoying bug with ChatGippity
		showPieChart = false;       // temporarily remove chart from DOM
		StateHasChanged();          // trigger the UI update to unmount the chart
		await Task.Delay(10);       // short delay to give Blazor time to destroy the component
		showPieChart = true;        // re-render the chart from scratch

		//Load BarChart with data
		var monthlyResult = await DashboardService.GetMonthlyAdditionsAsync();
		if (monthlyResult.IsSuccess && monthlyResult.Value != null)
		{
			Data = monthlyResult.Value
				.OrderBy(d => Enum.TryParse(typeof(Months), d.Month, out var result)
					? (int)result
				: 13)
					.ToList();
		}

		ChartOptions = new ApexChartOptions<BarChartData>
		{
			Chart = new Chart
			{
				Type = ChartType.Bar,
				Width = "100%",
				Height = 260
			},

			Title = new Title
			{
				Text = "Tilskudd per måned",
				Style = new TitleStyle
				{
					Color = Theme.Chart.Text,
					FontFamily = "Franklin Gothic Medium, Arial Narrow, Arial, sans-serif",
					FontWeight = 500,

				}

			},

			Xaxis = new XAxis
			{
				Categories = Data.Select(d => d?.Month?.Substring(0, 3)).ToList(),
				Labels = new XAxisLabels
				{
					Style = new AxisLabelStyle
					{
						Colors = Theme.Chart.Text
					}
				}
			},

			Yaxis = new List<YAxis>
				{
					new YAxis
					{
						Labels = new YAxisLabels
						{
							Style = new AxisLabelStyle
							{
								Colors = Theme.Chart.Text
							}
						}
					}
				},

			Legend = new Legend
			{
				Show = true,
				Labels = new LegendLabels
				{
					Colors = Theme.Chart.Text
				}
			}
		};

		ApplyThemeColors(ChartOptions);
		if (Theme.Chart.Grid != null)
			ChartOptions.Grid = new Grid { BorderColor = Theme.Chart.Grid };

		isLoading = false;
		StateHasChanged();
		await Task.Delay(300);
		if (barChart is not null)
		{
			await barChart.UpdateSeriesAsync();
			await barChart.UpdateOptionsAsync(true, true, true);
		}		
	}

	// Theme colours for things CSS can't reach. Standard leaves ApexCharts' defaults untouched.
	private void ApplyThemeColors<T>(ApexChartOptions<T> options) where T : class
	{
		if (Theme.Chart.Palette != null)
			options.Colors = Theme.Chart.Palette.ToList();

		if (Theme.IsDark)
		{
			options.Tooltip ??= new Tooltip();
			options.Tooltip.Theme = Mode.Dark;
		}
	}
}
