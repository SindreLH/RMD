@page "/Dashboard"
@attribute [Authorize]
@using RMD.Business.Services
@using RMD.Data.Models
@using RMD.Data.Models.Dashboard
@inject IDashboardService DashboardService
@inject NavigationManager Navigation
@using RMD.GUI.Infrastructure

<PageTitle>RMD | Dashboard</PageTitle>

<div class="dashboard">
	<div class="dashboard__stats">
		<section class="rmd-panel stat-card" aria-label="Låter">
			@if (isLoading)
			{
				<div class="stat-card__loader">
					<img src="/images/Loader.gif" alt="" />
					<p>Laster inn låter...</p>
				</div>
			}
			else
			{
				<p class="stat-card__value">@(songCount?.Value ?? 0) Låter</p>
				<p>@(playedSongCount?.Value ?? 0) Promoterte</p>
				<p class="stat-card__latest">
					<span class="green_plus">+</span>
					@(latestSong != null && latestSong.IsSuccess ? latestSong.Value.Title : "Ingen sanger funnet")
				</p>
			}
		</section>

		<section class="rmd-panel stat-card" aria-label="Artister">
			@if (isLoading)
			{
				<div class="stat-card__loader">
					<img src="/images/Loader.gif" alt="" />
					<p>Laster inn artister...</p>
				</div>
			}
			else
			{
				<p class="stat-card__value">@(artistCount?.Value ?? 0) Artister</p>
				<p>@(artistNationCount?.Value ?? 0) Nasjonaliteter</p>
				<p class="stat-card__latest">
					<span class="green_plus">+</span>
					@(latestArtist != null && latestArtist.IsSuccess ? latestArtist.Value.Name : "Ingen artister funnet")
				</p>
			}
		</section>
	</div>

	<div class="dashboard__charts">
		<section class="rmd-panel chart-card" aria-label="Tilskudd per måned">
			<ApexChart TItem="BarChartData"
						   @ref="barChart"
						   Options="ChartOptions">
					<ApexPointSeries TItem="BarChartData"
									 Items="Data"
									 Name="Nye låter"
									 SeriesType="SeriesType.Bar"
									 XValue="e => e.Month"
									 YValue="e => e.NewSongs" />
					<ApexPointSeries TItem="BarChartData"
									 Items="Data"
									 Name="Nye artister"
									 SeriesType="SeriesType.Bar"
									 XValue="e => e.Month"
									 YValue="e => e.NewArtists" />
				</ApexChart>
		</section>

		<section class="rmd-panel chart-card" aria-label="Sjangerfordeling">
			@if (showPieChart)
				{
					<ApexChart TItem="PieChartData"
							   @ref="pieChart"
							   Options="PieChartOptions">
						<ApexPointSeries TItem="PieChartData"
										 Items="PieChartDataList"
										 SeriesType="SeriesType.Pie"
										 YValue="e => e.Value"
										 XValue="e => e.Label" />
					</ApexChart>
				}
		</section>
	</div>

	<section class="dashboard__wanted" aria-label="Ønskede låter">
		<div class="rmd-table-wrap">
			<table class="table table-bordered table-dark table-striped table-hover rmd-table rmd-table--stack">
				<thead>
					<tr>
						<th class="rmd-col-xl">#</th>
						<th>Ønsket låt</th>
						<th class="rmd-col-lg">Lengde</th>
						<th class="rmd-col-xl">Extended</th>
						<th class="rmd-col-lg">Sjanger</th>
						<th>Kilde</th>
					</tr>
				</thead>

				<tbody>
					@foreach (var song in wantedSongs?.Value ?? Enumerable.Empty<Song>())
					{
						<tr>
							<td class="rmd-col-xl rmd-hide-stack" data-label="#">@song.SongId</td>
							<td class="rmd-cell-title">@song.Title</td>
							<td class="rmd-col-lg" data-label="Lengde">@song.Length</td>
							<td class="rmd-col-xl" data-label="Extended">@(song.ExtendedMix ? "✅" : "❌")</td>
							<td class="rmd-col-lg" data-label="Sjanger">@song.Genre</td>
							<td class="rmd-truncate" style="--rmd-truncate-max: 16rem" data-label="Kilde">@if (SafeUrl.ForHref(song.WantedSongUrl) is string wantedUrl)
								{
									<a href="@wantedUrl" target="_blank" rel="noopener noreferrer" title="@wantedUrl">@wantedUrl</a>
								}</td>
						</tr>
					}
				</tbody>
			</table>
		</div>

		@if (wantedSongs == null)
		{
			<div class="rmd-loader">
				<img src="/images/Loader.gif" alt="" />
				<p>Laster inn låter...</p>
			</div>
		}
		else if (!wantedSongs.IsSuccess)
		{
			<div class="rmd-empty">
				<p>Ingen ønskede låter akkurat nå.</p>
			</div>
		}
	</section>

	<aside class="rmd-panel dashboard__resources" aria-label="Ressurser">
		<h2>Ressurser</h2>

		<div class="icon_heading">
			<i class="bi bi-info-circle-fill" style="color: var(--rmd-icon-accent);"></i>
			<h5> Informasjon</h5>
		</div>
		
		<div class="resource_item">
			<a href="https://www.discogs.com" target="_blank" rel="noopener noreferrer">🔗 Discogs.com</a>
		</div>
		<div class="resource_item">
			<a href="https://www.lololyrics.com" target="_blank" rel="noopener noreferrer">🔗 Lololyrics.com</a>
		</div>
		
		<div class="icon_heading">
			<i class="bi bi-cart4" style="color: var(--rmd-icon-accent);"></i>
			<h5> Nettbutikker</h5>
		</div>
		
		<div class="resource_item">
			<a href="https://www.beatport.com" target="_blank" rel="noopener noreferrer">🔗 Beatport.com</a>
		</div>
		<div class="resource_item">
			<a href="https://www.junodownload.com" target="_blank" rel="noopener noreferrer">🔗 Junodownload.com</a>
		</div>
		<div class="resource_item">
			<a href="https://www.hardstyle.com" target="_blank" rel="noopener noreferrer">🔗 Hardstyle.com</a>
		</div>
		<div class="resource_item">
			<a href="https://www.trackitdown.com" target="_blank" rel="noopener noreferrer">🔗 Trackitdown.com</a>
		</div>
		
		<div class="icon_heading">
			<i class="bi bi-download" style="color: var(--rmd-icon-accent);"></i>
			<h5> Nedlasting</h5>
		</div>
		
		
		<div class="resource_item">
			<a href="https://bootlegs-load.de/" target="_blank" rel="noopener noreferrer">🔗 Bootlegs-load.de</a>
		</div>
		<div class="resource_item">
			<a href="https://www.handsup.dance" target="_blank" rel="noopener noreferrer">🔗 Handsup.dance</a>
		</div>
		<div class="resource_item">
			<a href="https://handsuppowo.pl" target="_blank" rel="noopener noreferrer">🔗 Handsuppowo.pl</a>
		</div>
		<div class="resource_item">
			<a href="https://ytmp3.cc/5Hcs/" target="_blank" rel="noopener noreferrer">🔗 ytmp3.cc</a>
		</div>
		<div class="resource_item">
			<a href="https://www.domegarecords.com/bootlegs" target="_blank" rel="noopener noreferrer">🔗 Domega Records Bootlegs</a>
		</div>
		<div class="resource_item">
			<a href="https://www.youtube.com/watch?v=UyOZo6rzDvc" target="_blank" rel="noopener noreferrer">🔗 HHH YouTube Channel</a>
		</div>
