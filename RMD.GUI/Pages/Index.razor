@page "/"
@using RMD.Business.Services
@using RMD.Data.Models
@using RMD.Data.Models.Dashboard
@inject IDashboardService DashboardService
@inject NavigationManager Navigation

<PageTitle>RMD | Dashboard</PageTitle>

<div class="main_container">
	<div class="left_container">

		<div class="cards_container">
			<div class="data_card">
				@if (isLoading)
				{
					<div class="card_loader">
						<img src="/images/Loader.gif" alt="Loading..." class="load_spinner" />
						<p class="card_loader_text">Laster inn låter...</p>
					</div>
				}
				else
				{
					<h3><strong>@songCount?.Value Låter</strong></h3>
					<p>@playedSongCount?.Value Promoterte</p>
					<div class="newly_added">
						@if (latestSong != null && latestSong.IsSuccess)
						{
							<p class="green_plus">+</p>
							<p>@latestSong.Value.Title</p>
						}
						else
						{
							<p class="green_plus">+</p>
							<p>Ingen sanger funnet</p>
						}
					</div>
				}
			</div>


			<div class="data_card">
				@if (isLoading)
				{
					<div class="card_loader">
						<img src="/images/Loader.gif" alt="Loading..." class="load_spinner" />
						<p class="card_loader_text">Laster inn artister...</p>
					</div>
				}
				else
				{
					<h3><strong>@artistCount?.Value Artister</strong></h3>
					<p>@artistNationCount?.Value Nasjonaliteter</p>
					<div class="newly_added">
						@if (latestArtist != null && latestArtist.IsSuccess)
						{
							<p class="green_plus">+</p>
							<p>@latestArtist.Value.Name</p>
						}
						else
						{
							<p class="green_plus">+</p>
							<p>Ingen artister funnet</p>
						}
					</div>
				}
			</div>
		</div>

		<div class="graphs_container">
			<div class="chart">
				<ApexChart TItem="BarChartData"
						   @ref="barChart"
						   Options="ChartOptions">
					<ApexPointSeries TItem="BarChartData"
									 Items="Data"
									 Name="Nye låter"
									 SeriesType="SeriesType.Bar"
									 XValue="e => e.Month"
									 YValue="e => e.NewSongs" />
					<ApexPointSeries TItem="BarChartData"
									 Items="Data"
									 Name="Nye artister"
									 SeriesType="SeriesType.Bar"
									 XValue="e => e.Month"
									 YValue="e => e.NewArtists" />
				</ApexChart>
			</div>

			<div class="chart">
				@if (showPieChart)
				{
					<ApexChart TItem="PieChartData"
							   @ref="pieChart"
							   Options="PieChartOptions">
						<ApexPointSeries TItem="PieChartData"
										 Items="PieChartDataList"
										 SeriesType="SeriesType.Pie"
										 YValue="e => e.Value"
										 XValue="e => e.Label" />
					</ApexChart>
				}

			</div>

		</div>

		<div class="table_container">
			<table class="table table-bordered table-dark table-striped table-hover">
				<thead class="thead-light">
					<tr>
						<th class="hide-mobile">#</th>
						<th>Ønsket låt</th>
						<th class="hide-mobile">Lengde</th>
						<th class="hide-mobile">Extended</th>
						<th class="hide-mobile">Sjanger</th>
						<th>Kilde</th>
					</tr>
				</thead>

				<tbody>
					@foreach (var song in wantedSongs?.Value ?? Enumerable.Empty<Song>())
					{
						<tr>
							<td class="hide-mobile">@song.SongId</td>
							<td>@song.Title</td>
							<td class="hide-mobile">@song.Length</td>
							<td class="hide-mobile">@(song.ExtendedMix ? "✅" : "❌")</td>
							<td class="hide-mobile">@song.Genre</td>
							<td class="text-truncate" style="max-width: 180px">
								<a href="@song.WantedSongUrl"
								   target="_blank"
								   rel="noopener noreferrer"
								   title="@song.WantedSongUrl">
									@song.WantedSongUrl
								</a>
							</td>
						</tr>
					}

				</tbody>
			</table>

			@if (wantedSongs == null)
			{
				<div class="load_container">
					<div class="load_contents">
						<img src="/images/Loader.gif" alt="Loading..." class="load_spinner" />
						<p class="load_text">Laster inn låter...</p>
					</div>
				</div>
			}

		</div>
	</div>

	<div class="right_container">

		<div class="resources_container">
			<h2 style="margin-left:3rem;">Ressurser</h2>


			<div class="icon_heading">
				<i class="bi bi-info-circle-fill" style="color: #feb019;"></i>
				<h5> Informasjon</h5>
			</div>
			
			<div class="resource_item">
				<a href="https://www.discogs.com">🔗 Discogs.com</a>
			</div>
			<div class="resource_item">
				<a href="https://www.lololyrics.com">🔗 Lololyrics.com</a>
			</div>


			<div class="icon_heading">
				<i class="bi bi-cart4" style="color: #ff4560;"></i>
				<h5> Nettbutikker</h5>
			</div>

			

			<div class="resource_item">
				<a href="https://www.beatport.com">🔗 Beatport.com</a>
			</div>
			<div class="resource_item">
				<a href="https://www.junodownload.com">🔗 Junodownload.com</a>
			</div>
			<div class="resource_item">
				<a href="https://www.hardstyle.com">🔗 Hardstyle.com</a>
			</div>
			<div class="resource_item">
				<a href="https://www.trackitdown.com">🔗 Trackitdown.com</a>
			</div>

			@* <h5>💾 Nedlasting</h5> *@
			<div class="icon_heading">
				<i class="bi bi-download" style="color: #00e396;"></i>
				<h5> Nedlasting</h5>
			</div>

			
			<div class="resource_item">
				<a href="https://bootlegs-load.de/">🔗 Bootlegs-load.de</a>
			</div>
			<div class="resource_item">
				<a href="https://www.discogs.com">🔗 Handsup.dance</a>
			</div>
			<div class="resource_item">
				<a href="https://www.handsup.dance">🔗 Handsuppowo.pl</a>
			</div>
			<div class="resource_item">
				<a href="https://ytmp3.cc/5Hcs/">🔗 ytmp3.cc</a>
			</div>
			<div class="resource_item">
				<a href="https://www.domegarecords.com/bootlegs">🔗 Domega Records Bootlegs</a>
			</div>
			<div class="resource_item">
				<a href="https://www.youtube.com/watch?v=UyOZo6rzDvc">🔗 HHH YouTube Channel</a>
			</div>
			<div class="resource_item">
				<a href="https://drive.google.com/drive/folders/1m73grdC9----GRBPkwRjh1RfPXFfqmZG">🔗 Unreal Project Promo Drive</a>
			</div>
			<div class="resource_item">
				<a href="https://nuteczki.eu/tags/hands+up">🔗 Nuteczki.eu Forums</a>
			</div>
		</div>
	</div>

</div>


@code {
	private ApexChartOptions<BarChartData> ChartOptions { get; set; } = new();
	private List<BarChartData> Data { get; set; } = new();
	private ApexChartOptions<PieChartData> PieChartOptions { get; set; } = new();
	private List<PieChartData> PieChartDataList { get; set; } = new();
	private List<string> PieLabels = new();
	private List<double?> PieValues = new();

	private ApexChart<BarChartData>? barChart;
	private ApexChart<PieChartData>? pieChart;

	private Result<Song>? latestSong;
	private Result<Artist>? latestArtist;
	private Result<int>? artistCount;
	private Result<int>? songCount;
	private Result<int>? playedSongCount;
	private Result<int>? artistNationCount;
	private Result<IEnumerable<Song>>? wantedSongs;
	private Result<Dictionary<string, double>>? genreDictionary;
	private Result<Dictionary<string, int>>? genreCount;

	private bool isLoading = true;
	private bool showPieChart = true;

	protected override async Task OnInitializedAsync()
	{
		await Task.Delay(300);


		latestSong = await DashboardService.GetLatestSongAsync();
		latestArtist = await DashboardService.GetLatestArtistAsync();
		artistCount = await DashboardService.GetArtistCountAsync();
		songCount = await DashboardService.GetSongCountAsync();
		playedSongCount = await DashboardService.GetPlayedSongCountAsync();
		artistNationCount = await DashboardService.GetArtistNationCountAsync();
		wantedSongs = await DashboardService.GetWantedSongsAsync();
		genreCount = await DashboardService.GetGenreCountAsync();

		//Load PieChart with data
		var genreCountsResult = await DashboardService.GetGenreCountAsync();
		if (genreCountsResult.IsSuccess && genreCountsResult.Value != null)
		{
			PieChartDataList.Clear();

			foreach (var kvp in genreCountsResult.Value)
			{
				PieChartDataList.Add(new PieChartData
				{
					Label = kvp.Key ?? "Ukjent sjanger",
					Value = kvp.Value,
					Count = kvp.Value
				});
			}

			var labels = PieChartDataList.Select(d => d.Label).ToList();

			PieChartOptions = new ApexChartOptions<PieChartData>
			{
				Labels = labels,

				Tooltip = new Tooltip
				{
					Custom = @"
				function({ series, seriesIndex, w }) {
					const label = w.globals.labels[seriesIndex];
					const count = series[seriesIndex];
					const total = series.reduce((a, b) => a + b, 0);
					const percentage = ((count / total) * 100).toFixed(1);
					return label + ': ' + count + ' låter (' + percentage + '%)';
				}"
				},

				Title = new Title
				{
					Text = "Sjangerfordeling",
					Style = new TitleStyle
					{
						Color = "#ffffff",
						FontFamily = "Franklin Gothic Medium, Arial Narrow, Arial, sans-serif",
						FontWeight = 500
					}
				},

				Chart = new Chart
				{
					Type = ChartType.Pie,
					Width = "150%",
					Height = "91%"
				},

				Legend = new Legend
				{
					Show = true,
					Position = LegendPosition.Bottom,
					FontFamily = "Franklin Gothic Medium, Arial Narrow, Arial, sans-serif",
					Labels = new LegendLabels
					{
						Colors = "#ffffff"
					}
				},

				Stroke = new Stroke
				{
					Show = false,
					Width = new List<int> { 0 }
				}
			};
		}


		// Fixing an annoying bug with ChatGippity
		showPieChart = false;       // temporarily remove chart from DOM
		StateHasChanged();          // trigger the UI update to unmount the chart
		await Task.Delay(10);       // short delay to give Blazor time to destroy the component
		showPieChart = true;        // re-render the chart from scratch

		//Load BarChart with data
		var monthlyResult = await DashboardService.GetMonthlyAdditionsAsync();
		if (monthlyResult.IsSuccess && monthlyResult.Value != null)
		{
			Data = monthlyResult.Value
				.OrderBy(d => Enum.TryParse(typeof(Months), d.Month, out var result)
					? (int)result
				: 13)
					.ToList();
		}

		ChartOptions = new ApexChartOptions<BarChartData>
		{
			Chart = new Chart
			{
				Type = ChartType.Bar,
				Width = "139%",
				Height = "90%"
			},

			Title = new Title
			{
				Text = "Tilskudd per måned",
				Style = new TitleStyle
				{
					Color = "#ffffff",
					FontFamily = "Franklin Gothic Medium, Arial Narrow, Arial, sans-serif",
					FontWeight = 500,

				}

			},

			Xaxis = new XAxis
			{
				Categories = Data.Select(d => d?.Month?.Substring(0, 3)).ToList(),
				Labels = new XAxisLabels
				{
					Style = new AxisLabelStyle
					{
						Colors = "#ffffff"
					}
				}
			},

			Yaxis = new List<YAxis>
				{
					new YAxis
					{
						Labels = new YAxisLabels
						{
							Style = new AxisLabelStyle
							{
								Colors = "#ffffff"
							}
						}
					}
				},

			Legend = new Legend
			{
				Show = true,
				Labels = new LegendLabels
				{
					Colors = "#ffffff"
				}
			}
		};

		isLoading = false;
		StateHasChanged();
		await Task.Delay(300);
		if (barChart is not null)
		{
			await barChart.UpdateSeriesAsync();
			await barChart.UpdateOptionsAsync(true, true, true);
		}		
	}
}


