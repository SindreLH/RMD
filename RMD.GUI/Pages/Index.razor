@code {
	private ApexChartOptions<MyData> ChartOptions { get; set; } = new();
	private List<MyData> Data { get; set; } = new();

	private ApexChartOptions<PieChartData> PieChartOptions { get; set; } = new();
	private List<PieChartData> PieChartDataList { get; set; } = new();

	private Result<Song>? latestSong;
	private Result<Artist>? latestArtist;
	private Result<int>? artistCount;
	private Result<int>? songCount;
	private bool isLoading = true;

	public class PieChartData
	{
		public string? Label { get; set; }
		public int Value { get; set; }
	}

	public class MyData
	{
		public string? Category { get; set; }
		public int NewSongs { get; set; }
		public int NewArtists { get; set; }
	}

	protected override async Task OnInitializedAsync()
	{
		latestSong = await DashboardService.GetLatestSongAsync();
		latestArtist = await DashboardService.GetLatestArtistAsync();
		artistCount = await DashboardService.GetArtistCountAsync();
		songCount = await DashboardService.GetSongCountAsync();
		isLoading = false;
		StateHasChanged(); 

		Data.Add(new MyData { Category = "Jan", NewSongs = 12, NewArtists = 33 });
		Data.Add(new MyData { Category = "Feb", NewSongs = 43, NewArtists = 42 });
		Data.Add(new MyData { Category = "Mar", NewSongs = 112, NewArtists = 23 });
		Data.Add(new MyData { Category = "Apr", NewSongs = 7, NewArtists = 2 });
		Data.Add(new MyData { Category = "Mai", NewSongs = 43, NewArtists = 2 });
		Data.Add(new MyData { Category = "Jun", NewSongs = 63, NewArtists = 1 });
		Data.Add(new MyData { Category = "Jul", NewSongs = 92, NewArtists = 34 });
		Data.Add(new MyData { Category = "Aug", NewSongs = 5, NewArtists = 2 });
		Data.Add(new MyData { Category = "Sep", NewSongs = 8, NewArtists = 1 });
		Data.Add(new MyData { Category = "Okt", NewSongs = 45, NewArtists = 18 });
		Data.Add(new MyData { Category = "Nov", NewSongs = 34, NewArtists = 10 });
		Data.Add(new MyData { Category = "Des", NewSongs = 23, NewArtists = 2 });

		PieChartDataList.Add(new PieChartData { Label = "Hands Up", Value = 146 });
		PieChartDataList.Add(new PieChartData { Label = "Hardstyle", Value = 306 - 196 });
		PieChartDataList.Add(new PieChartData { Label = "Trance", Value = 306 - 230 });
		PieChartDataList.Add(new PieChartData { Label = "Hard Trance", Value = 306 - 188 });
		PieChartDataList.Add(new PieChartData { Label = "UK Hardcore", Value = 306 - 188 });

		ChartOptions = new ApexChartOptions<MyData>
			{
				Chart = new Chart
				{
					Type = ChartType.Bar,
					Width = "139%",
					Height = "90%"
				},

				Title = new Title
				{
					Text = "Nylig lagt til",
					Style = new TitleStyle
					{
						Color = "#ffffff",
						FontFamily = "Franklin Gothic Medium, Arial Narrow, Arial, sans-serif",
						FontWeight = 500,

					}

				},

				Xaxis = new XAxis
				{
					Labels = new XAxisLabels
					{
						Style = new AxisLabelStyle
						{
							Colors = "#ffffff"
						}
					}
				},

				Yaxis = new List<YAxis>
				{
					new YAxis
					{
						Labels = new YAxisLabels
						{
							Style = new AxisLabelStyle
							{
								Colors = "#ffffff"
							}
						}
					}
				},

				Legend = new Legend
				{
				Show = true,
				Labels = new LegendLabels
				{
					Colors = "#ffffff"
				}
				}
			};

		PieChartOptions = new ApexChartOptions<PieChartData>
		{
			Title = new Title
			{
				Text = "Andel per sjanger",
				Style = new TitleStyle
				{
					Color = "#ffffff",
					FontFamily = "Franklin Gothic Medium, Arial Narrow, Arial, sans-serif",
					FontWeight = 500
				}
			},

			Chart = new Chart
			{
				Type = ChartType.Pie,
				Width = "150%",
				Height = "91%"
			},

			Labels = PieChartDataList.Select(d => d.Label).ToList(),

			Legend = new Legend
			{
				Show = true,
				Position = LegendPosition.Bottom,
				FontFamily = "Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif",
				Labels = new LegendLabels
				{
					Colors = "#ffffff"
				}
			},

			Stroke = new Stroke
			{
				Show = false
			}

		};

	}
}
