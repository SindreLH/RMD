@using RMD.Business.Services;
@using RMD.Data.Models;
@using RMD.GUI.Infrastructure;
@using RMD.GUI.Pages.Components.Toasts;

@inject NavigationManager Nav
@inject ToastService Toast

@page "/login"
@attribute [AllowAnonymous]
@layout AuthLayout


<PageTitle>RMD | Logg inn</PageTitle>
<div class="rmd-auth-card">
	<h1>Logg inn</h1>

	<form method="post" action="/auth/login" class="d-flex flex-column gap-3">
		<AntiforgeryInput />
		<input type="hidden" name="returnUrl" value="@safeReturnUrl" />

		<div class="rmd-field">
			<label for="email">E-post</label>
			<input id="email" name="Email" type="email" autocomplete="username" class="form-control" required />
		</div>

		<div class="rmd-field">
			<label for="password">Passord</label>
			<input id="password" name="Password" type="password" autocomplete="current-password" class="form-control" required />
		</div>

		<div class="rmd-auth-row">
			<label class="d-inline-flex align-items-center gap-2">
				<input type="checkbox" name="RememberMe" value="true" class="form-check-input m-0" />
				Husk meg
			</label>
			<a href="/ForgotPassword">Glemt passord?</a>
		</div>

		<button type="submit" class="btn btn-success mt-3">
			Logg inn
		</button>
	</form>
</div>

@code {
	[CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

	[SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
	[SupplyParameterFromQuery] public string? Reason { get; set; }
	[SupplyParameterFromQuery(Name = "reset")] public string? Reset { get; set; }

	private string safeReturnUrl = "/dashboard";

	protected override async Task OnInitializedAsync()
	{
		safeReturnUrl = LocalUrl.OrDefault(ReturnUrl);

		// Already signed in: skip the login form
		var state = await AuthState;
		if (state.User.Identity?.IsAuthenticated == true)
			Nav.NavigateTo(safeReturnUrl, replace: true);
	}

	protected override void OnAfterRender(bool firstRender)
	{
		if (!firstRender) return;

		var message = Reason switch
		{
			"invalid" => "Innlogging feilet. Kontroller innloggingsdetaljer.",
			"locked" => "For mange mislykkede forsøk. Kontoen er låst i 15 minutter.",
			"ratelimited" => "For mange forsøk. Vent litt og prøv igjen.",
			_ => null
		};

		if (message != null)
			Toast.ShowToast(message, ToastType.Warning);
		else if (Reset == "success")
			Toast.ShowToast("Passordet er endret. Logg inn med det nye passordet.", ToastType.Success);
	}
}
