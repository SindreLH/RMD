@using RMD.Business.Services
@using RMD.Data.Models
@using Microsoft.AspNetCore.Identity
@using System.ComponentModel.DataAnnotations

@page "/ResetPassword"
@attribute [AllowAnonymous]
@layout AuthLayout

@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Nav
@inject ToastService ToastService

@if (!string.IsNullOrEmpty(error))
{
	<div class="alert alert-danger">@error</div>
}
else
{
	<div class="main_container">
		<div class="form_container">
			<h1 style="color: white;">Tilbakestill passord</h1>

			<form method="post" action="/auth/ResetPassword" class="form_contents">

				@*Hidden input:
			Dette er fordi disse verdiene kommer fra querystring.
			Brukeren skal ikke kunne redigere disse. 
			De skal kun postes til controller*@

				<input type="hidden" name="Email" value="@model.Email" />
				<input type="hidden" name="Token" value="@model.Token" />

				<div class="password_fields">
					<input type="password"
						   name="Password"
						   placeholder="Velg et nytt passord"
						   autocomplete="new-password"
						   class="form-control"
						   required />


					<input type="password"
						   name="ConfirmPassword"
						   placeholder="Bekreft det nye passordet"
						   class="form-control"
						   autocomplete="new-password"
						   required />
				</div>


				@if (!string.IsNullOrEmpty(error))
				{
					<div class="alert alert-danger">
						@foreach (var err in error.Split("|"))
						{
							<div>@err</div>
						}
					</div>
				}

				<button type="submit" class="btn btn-success">Lagre nytt passord</button>
			</form>
		</div>
	</div>
}




@code {
	private string? error;

	public ResetPasswordModel model = new();

	protected override void OnInitialized()
	{
		var uri = Nav.ToAbsoluteUri(Nav.Uri);
		var query = System.Web.HttpUtility.ParseQueryString(uri.Query);

		model.Email = query["email"] ?? "";
		model.Token = query["token"] ?? "";

		var errorString = query["error"];

		if (string.IsNullOrEmpty(model.Email) || string.IsNullOrEmpty(model.Token))
		{
			error = "Ugyldig eller utløpt reset-lenke.";
		}

	}

	public class ResetPasswordModel
	{
		[EmailAddress]
		public string Email { get; set; } = "";

		public string Token { get; set; } = "";

		[Required]
		[DataType(DataType.Password)]
		[MinLength(8)]
		public string Password { get; set; } = "";

		[Required]
		[Compare("Password",ErrorMessage = "Passordene matcher ikke.")]
		public string ConfirmPassword { get; set; } = "";
	}


}