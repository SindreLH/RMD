@using System.ComponentModel.DataAnnotations

@page "/ResetPassword"
@attribute [AllowAnonymous]
@layout AuthLayout

<PageTitle>RMD | Tilbakestill passord</PageTitle>

<div class="main_container">
	<div class="form_container">
		<h1 style="color: white;">Tilbakestill passord</h1>

		@if (!hasLink)
		{
			<div class="alert alert-danger">Ugyldig eller utløpt reset-lenke.</div>
			<a href="/ForgotPassword" style="color: white;">Be om en ny lenke</a>
		}
		else
		{
			<form method="post" action="/auth/ResetPassword" class="form_contents">
				<AntiforgeryInput />

				@*Hidden input:
				Dette er fordi disse verdiene kommer fra querystring.
				Brukeren skal ikke kunne redigere disse.
				De skal kun postes til controller*@

				<input type="hidden" name="Email" value="@Email" />
				<input type="hidden" name="Token" value="@Token" />

				<div class="password_fields">
					<input type="password"
						   name="Password"
						   placeholder="Velg et nytt passord"
						   autocomplete="new-password"
						   class="form-control"
						   minlength="8"
						   required />


					<input type="password"
						   name="ConfirmPassword"
						   placeholder="Bekreft det nye passordet"
						   class="form-control"
						   autocomplete="new-password"
						   required />
				</div>

				@if (errors.Length > 0)
				{
					<div class="alert alert-danger">
						@foreach (var err in errors)
						{
							<div>@err</div>
						}
					</div>
				}

				<button type="submit" class="btn btn-success">Lagre nytt passord</button>
			</form>
		}
	</div>
</div>


@code {
	[SupplyParameterFromQuery(Name = "email")] public string? Email { get; set; }
	[SupplyParameterFromQuery(Name = "token")] public string? Token { get; set; }
	[SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }

	private bool hasLink;
	private string[] errors = Array.Empty<string>();

	protected override void OnParametersSet()
	{
		hasLink = !string.IsNullOrEmpty(Email) && !string.IsNullOrEmpty(Token);
		errors = string.IsNullOrEmpty(Error)
			? Array.Empty<string>()
			: Error.Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
	}

	public class ResetPasswordModel
	{
		[Required, EmailAddress]
		public string Email { get; set; } = "";

		[Required]
		public string Token { get; set; } = "";

		[Required(ErrorMessage = "Passord må fylles ut.")]
		[DataType(DataType.Password)]
		[MinLength(8, ErrorMessage = "Passordet må være minst 8 tegn.")]
		public string Password { get; set; } = "";

		[Required]
		[Compare("Password",ErrorMessage = "Passordene matcher ikke.")]
		public string ConfirmPassword { get; set; } = "";
	}
}
