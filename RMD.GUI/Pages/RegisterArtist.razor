@using RMD.GUI.Pages.Components
@using RMD.GUI.Pages.Components.Toasts
@using RMD.Data.Models
@using RMD.Data.Models.DTO
@using RMD.Business.Services

@inject ToastService ToastService
@inject IArtistService ArtistService
@page "/AddArtist"
@attribute [Authorize]

<PageTitle>RMD | Legg til artist</PageTitle>

<section class="rmd-panel register-card">
	<h2 class="h4 mb-4">Ny artist</h2>

	<EditForm Model="newArtistDto" OnValidSubmit="SaveArtist">
		<DataAnnotationsValidator />

		<div class="rmd-artist-form">
			<div class="rmd-artist-form__row">
				<div class="rmd-field">
					<label for="artistName">Navn</label>
					<InputText id="artistName" @bind-Value="newArtistDto.Name" class="form-control" />
					<ValidationMessage For="@(() => newArtistDto.Name)" />
				</div>

				<div class="rmd-field">
					<label for="artistNationality">Land</label>
					<InputSelect id="artistNationality" @bind-Value="newArtistDto.Nationality" class="form-control">
						@NationalityOptions.Options
					</InputSelect>
					<ValidationMessage For="@(() => newArtistDto.Nationality)" />
				</div>
			</div>

			<div class="rmd-field">
				<label for="artistFacebook">Facebook</label>
				<InputText id="artistFacebook" type="url" @bind-Value="newArtistDto.FacebookUrl" class="form-control" />
			</div>

			<div class="rmd-field">
				<label for="artistSoundcloud">Soundcloud</label>
				<InputText id="artistSoundcloud" type="url" @bind-Value="newArtistDto.SoundcloudUrl" class="form-control" />
			</div>

			<div class="rmd-field">
				<label for="profilePicture">Profilbilde</label>
				<InputText id="profilePicture" type="url" @bind-Value="newArtistDto.ProfilePicUrl" class="form-control" />
			</div>

			<div class="rmd-field">
				<label for="artistDiscogs">Discogs</label>
				<InputText id="artistDiscogs" type="url" @bind-Value="newArtistDto.DiscogsUrl" class="form-control" />
			</div>
		</div>

		<div class="register-card__actions">
			<button type="submit" class="btn btn-success">
				<i class="bi bi-floppy-fill"></i> Lagre artist
			</button>
		</div>
	</EditForm>
</section>



@code {
	private ArtistDto newArtistDto = new ArtistDto
	{

		//Init required members 
		Name = string.Empty,
		Nationality = string.Empty
	};

	private async Task SaveArtist()
	{

		var result = await ArtistService.CreateNewArtistAsync(newArtistDto);

		if (result.IsSuccess)
		{

			// Truncating long artist names
			var name = result.Value.Name.Length > 18
			? result.Value.Name[..18] + "..." :  result.Value.Name;

			ToastService.ShowToast($"SUKSESS! {name} ble opprettet! ", ToastType.Success);

			newArtistDto = new ArtistDto
				{
					Name = string.Empty,
					Nationality = string.Empty
				};

			StateHasChanged();
		}
		else
		{
			if (result.Error.Contains("already exists", StringComparison.OrdinalIgnoreCase))
			{
				// Truncating long artist names
				var name = newArtistDto.Name.Length > 18
					? newArtistDto.Name[..18] + "..."
					: newArtistDto.Name;

				ToastService.ShowToast($"ADVARSEL: {name} finnes allerede i databasen.", ToastType.Warning);
			}
			else
			{
				ToastService.ShowToast("FEIL: En ukjent feil oppstod. Prøv igjen senere.", ToastType.Error);
			}
		}
	}
}

	
