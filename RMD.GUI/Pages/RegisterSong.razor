@using RMD.GUI.Pages.Components
@using RMD.Data.Context
@using RMD.Data.Models
@using RMD.Data.Models.DTO
@using RMD.Business.Services
@using RMD.GUI.Pages.Components.Modals
@inject ISongService SongService 
@inject IArtistService ArtistService
@page "/AddSong"

<PageTitle>RMD | Add a new song</PageTitle>
@if (warningModalDuplicateVisible)
{
    <ErrorModalDuplicate IsVisible="true" OnClose="CloseModal" />
}
<div class="container_parent">
    <div class="main_form_container">



        <h3>Registrer låt</h3>

        <EditForm Model="newSongDto" OnValidSubmit="SaveSong">
            <DataAnnotationsValidator/>
            <div id="a_b_container">
                <div id="reg_song_part_a">
                    <div id="form-group">
                        <label>Tittel</label>
                        <InputText @bind-Value="newSongDto.Title" class="form-control"/>
                    </div>

                    <div id="form-group">
                        <label>Remixartist</label>
                        <InputSelect @bind-Value="newSongDto.RemixArtist" class="form-control">
                            <option value="">Velg remixartist</option>

                            @foreach (var artist in allArtists)
                            {
                                <option value="@artist.Name">@artist.Name</option>
                            }

                        </InputSelect>
                        <ValidationMessage For="@(() => newSongDto.RemixArtist)" />
                    </div>

                    <div id="form-group" style="margin-bottom: 15px;">
                        <label>Artist</label>
                        <InputSelect @bind-Value="newSongDto.ArtistId" class="form-control">
                            <option value="">Velg artist</option>

                            @foreach (var artist in allArtists)
                            {
                                <option value="@artist.ArtistId">@artist.Name</option>
                            }

                        </InputSelect>
                        <ValidationMessage For="@(() => newSongDto.ArtistId)" />
                    </div>


                    <div id="form-group">
                        <label>Lengde (MM:SS)</label>
                        <InputText @bind-Value="newSongDto.Length" class="form-control" />
                    </div>

                    <div id="form-group">
                        <label>Sjanger</label>
                        <InputSelect @bind-Value="newSongDto.Genre" class="form-control">
                            <option value="Hands Up">Hands Up</option>
                            <option value="Hard Trance">Hard Trance</option>
                            <option value="Hardstyle">Hardstyle</option>
                            <option value="Jumpstyle">Jumpstyle</option>
                            <option value="Trance">Trance</option>
                            <option value="Happy Hardcore">Happy Hardcore</option>
                            <option value="UK Hardcore">UK Hardcore</option>
                        </InputSelect>
                    </div>
                </div>
                <div id="reg_song_part_b">

                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="extendedMixSwitch" @bind="newSongDto.ExtendedMix">
                        <label class="form-check-label" for="flexSwitchCheckDefault">Extended Mix</label>
                        <label class="col-form-label-sm">Mix med intro og outro.</label>
                    </div>

                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="favoriteSwitch" @bind="newSongDto.Favorite">
                        <label class="form-check-label" for="flexSwitchCheckDefault">Favoritt</label>
                        <label class="col-form-label-sm">Låten har favorittstatus.</label>
                    </div>

                    <div class="form-check form-switch">
                        <input class="form-check-input"
                        type="checkbox"
                        id="playedSwitch"
                        @bind="playedIsToggled" />
                        <label class="form-check-label" for="playedSwitch">Spilt</label>
                        <label class="col-form-label-sm">Låten er spilt i en tidligere mixtape.</label>
                    </div>

                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="storedSwitch" @bind="newSongDto.Stored">
                        <label class="form-check-label" for="flexSwitchCheckDefault">Lagret</label>
                        <label class="col-form-label-sm">Låten er lagret i samlingen.</label>
                    </div>


                    <div class="form-check form-switch">
                        <input class="form-check-input"
                        type="checkbox"
                        id="wantedSwitch"
                        @bind="wantedIsToggled" />
                        <label class="form-check-label" for="wantedSwitch">Ønsket</label>
                        <label class="col-form-label-sm">Låten er ønsket og må skaffes.</label>
                    </div>

                    @if (playedIsToggled)
                    {
                        <div class="toggledInput">
                            <div id="form-group">
                                <label>Mixtape vol.</label>
                                <InputNumber class="form-control number_ticker" @bind-Value="newSongDto.PlayedInEp" />
                                <label class="col-form-label-sm">Låten er spilt i ep</label>
                            </div>
                        </div>
                    }

                    @if (wantedIsToggled)
                    {
                        <div class="toggledInput">
                            <div id="form-group">
                                <label>Låtkilde</label>
                                <InputText class="form-control" @bind-Value="newSongDto.WantedSongUrl" />
                                <label class="col-form-label-sm">URL til låten</label>
                            </div>
                        </div>
                    }

                </div>
            </div>

            <div class="save_button">
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-floppy-fill"></i> Lagre låt
                </button>
            </div>

            <div class="validation-container-song">
                <ValidationSummary class="fade-in"/>
            </div>
        </EditForm>
    </div>



</div>



@code {

    private bool playedIsToggled = false;
    private bool wantedIsToggled = false;
    private bool warningModalDuplicateVisible = false;

    private List<Artist> allArtists = new();

    private SongDto newSongDto = new SongDto
    {
        //Init required members
        Title = String.Empty,
        RemixArtist = String.Empty,
        ArtistId = 0, 
        Length = String.Empty,
        Genre = String.Empty,
    };

    protected override async Task OnInitializedAsync()
    {
        var result = await ArtistService.GetAllArtistsAsync();

        if (result.IsSuccess)
        {
            allArtists = result.Value.ToList();
        }
    }

    private void CloseModal()
    {
        warningModalDuplicateVisible = false;
    }

    private async Task SaveSong()
    {
        Console.WriteLine("Debug: SaveSong method was triggered!");

        // Sync toggles to DTO before saving
        newSongDto.Played = playedIsToggled;
        newSongDto.Wanted = wantedIsToggled;

        var result = await SongService.CreateNewSongAsync(newSongDto);

        if (result.IsSuccess)
        {
            // Resetting the form 
            playedIsToggled = false;
            wantedIsToggled = false;

            newSongDto = new SongDto
                {
                    Title = String.Empty,
                    RemixArtist = String.Empty,
                    ArtistId = null,
                    Length = String.Empty,
                    Genre = String.Empty,
                    ExtendedMix = false,
                    Favorite = false,
                    Played = false,
                    Stored = false,
                    Wanted = false,
                    PlayedInEp = null,
                    WantedSongUrl = String.Empty
                };

            warningModalDuplicateVisible = false;

            Console.WriteLine("Song successfully saved!");
        }
        else
        {
            Console.WriteLine($"Error: {result.Error}");

            if (result.Error.Contains("already exists", StringComparison.OrdinalIgnoreCase))
            {
                warningModalDuplicateVisible = true;
            }
        }
    }


    //Event Handlers for toggles
    private void OnPlayedChanged(ChangeEventArgs e)
    {
        playedIsToggled = newSongDto.Played;
    }

    private void OnWantedChange(ChangeEventArgs e)
    {
        wantedIsToggled = newSongDto.Wanted;
    }
}

