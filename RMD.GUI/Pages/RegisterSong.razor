@using RMD.GUI.Pages.Components
@using RMD.Data.Models
@using RMD.Data.Models.DTO
@using RMD.Business.Services
@using RMD.GUI.Pages.Components.Modals
@using RMD.GUI.Pages.Components.Toasts

@inject ToastService ToastService
@inject ISongService SongService
@inject IArtistService ArtistService
@page "/AddSong"
@attribute [Authorize]

<PageTitle>RMD | Legg til låt</PageTitle>


<div class="container_parent">
    <div class="main_form_container">
        <EditForm Model="newSongDto" OnValidSubmit="SaveSong" novalidate>
            <DataAnnotationsValidator/>
            <div id="a_b_container">
                <div id="reg_song_part_a">
                    <div id="form-group">
                        <label for="song-title">Tittel</label>
                        <InputText id="song-title" @bind-Value="newSongDto.Title" class="form-control"/>
                    </div>

                    <div id="form-group">
                        <label for="song-length">Lengde</label>
                        <InputText
                            id="song-length"
                            @bind-Value="newSongDto.Length"
                            class="form-control"
                            placeholder="MM:SS"
                            pattern="^[0-5]?\d:[0-5]\d$"
                            />

                    </div>

                    <div id="form-group">
                        <label for="song-genre">Sjanger</label>
                        <InputSelect id="song-genre" @bind-Value="newSongDto.Genre" class="form-control">
                            <option value="" style="color: gray;">Velg en sjanger</option>
                            <option value="Hands Up">Hands Up</option>
                            <option value="Hardstyle">Hardstyle</option>
                            <option value="House">House</option>
                            <option value="Trance">Trance</option>
                            <option value="Happy Hardcore">Happy Hardcore</option>
                        </InputSelect>
                    </div>


                    <div class="artist_rows_windows">
                        <div id="form-group" >
                            <label>Artister</label>

                            @foreach (var row in artistRows)
                            {
                                <div class="artist_selection_container" @key="row.Key">
                                    <InputSelect @bind-Value="row.SelectedId" TValue="int?" class="form-control">
                                        <option value="" style="color: gray;">Velg en artist</option>
                                        @foreach (var artist in allArtists)
                                        {
                                            <option value="@artist.ArtistId">@artist.Name</option>
                                        }
                                    </InputSelect>

                                    @if (artistRows.Count > 1)
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-danger ms-2"
                                                @onclick="() => RemoveArtistRow(row.Key)">
                                            -
                                        </button>
                                    }


                                    @if (row == artistRows[^1] && artistRows.Count < MaxRows)
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-light ms-2"
                                                title="Legg til artist"
                                                @onclick="AddArtistRows">
                                            +
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    @if(remixIsToggled == true)
                    {
                        <div class="artist_rows_windows" style="margin-top: 1rem;">
                            <div id="form-group">
                                <label>Remix artister</label>

                                @foreach (var row in remixerRows)
                                {
                                    <div class="artist_selection_container" @key="row.Key">
                                        <InputSelect @bind-Value="row.SelectedId" TValue="int?" class="form-control">
                                            <option value="" style="color: gray;">Velg en remix artist</option>
                                            @foreach (var artist in allArtists)
                                            {
                                                <option value="@artist.ArtistId">@artist.Name</option>
                                            }
                                        </InputSelect>

                                        @if (remixerRows.Count > 1)
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-danger ms-lg-3"
                                                    @onclick="() => RemoveRemixRow(row.Key)">
                                                -
                                            </button>


                                        }


                                        @if (row == remixerRows[^1] && remixerRows.Count < MaxRows)
                                        {
                                            <button type="button" class="btn btn-sm btn-light ms-2" title="Legg til remixartist" @onclick="AddRemixRows">+</button>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }



                </div>
                <div id="reg_song_part_b">

                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="remixSwitch" @bind="remixIsToggled">
                        <label class="form-check-label" for="remixSwitch">Remix</label>
                        <label class="col-form-label-sm">Aktiver artistvalg for remixartist.</label>
                    </div>


                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="extendedMixSwitch" @bind="newSongDto.ExtendedMix">
                        <label class="form-check-label" for="extendedMixSwitch">Extended Mix</label>
                        <label class="col-form-label-sm">Mix med intro og outro.</label>
                    </div>


                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="favoriteSwitch" @bind="newSongDto.Favorite">
                        <label class="form-check-label" for="favoriteSwitch">Favoritt</label>
                        <label class="col-form-label-sm">Låten har favorittstatus.</label>
                    </div>

                    <div class="form-check form-switch">
                        <input class="form-check-input"
                        type="checkbox"
                        id="playedSwitch"
                        @bind="playedIsToggled" />
                        <label class="form-check-label" for="playedSwitch">Spilt</label>
                        <label class="col-form-label-sm">Låten er spilt i en tidligere mixtape.</label>
                    </div>

                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="storedSwitch" @bind="newSongDto.Stored">
                        <label class="form-check-label" for="storedSwitch">Lagret</label>
                        <label class="col-form-label-sm">Låten er lagret i samlingen.</label>
                    </div>


                    <div class="form-check form-switch">
                        <input class="form-check-input"
                        type="checkbox"
                        id="wantedSwitch"
                        @bind="wantedIsToggled" />
                        <label class="form-check-label" for="wantedSwitch">Ønsket</label>
                        <label class="col-form-label-sm">Låten er ønsket og må skaffes.</label>
                    </div>

                    @if (playedIsToggled)
                    {
                        <div class="toggledInput">
                            <div id="form-group">
                                <label for="song-ep">Mixtape vol.</label>
                                <InputNumber id="song-ep" min="0" class="form-control number_ticker" @bind-Value="newSongDto.PlayedInEp" />
                                <label class="col-form-label-sm">Låten er spilt i ep</label>
                            </div>
                        </div>
                    }

                    @if (wantedIsToggled)
                    {
                        <div class="toggledInput">
                            <div id="form-group">
                                <label for="song-url">Låtkilde</label>
                                <InputText id="song-url" type="url" class="form-control" @bind-Value="newSongDto.WantedSongUrl" />
                                <label class="col-form-label-sm">URL til låten</label>
                            </div>
                        </div>
                    }

                </div>
            </div>

            <div class="save_button">
                <button type="submit" class="btn btn-success" disabled="@isSaving">
                    <i class="bi bi-floppy-fill"></i> @(isSaving ? "Lagrer..." : "Lagre låt")
                </button>
            </div>

            <div class="validation-container-song">
                <ValidationSummary class="fade-in"/>
            </div>
        </EditForm>
    </div>



</div>

@code {
    private const int MaxRows = 5;

    private bool playedIsToggled = false;
    private bool wantedIsToggled = false;
    private bool remixIsToggled = false;
    private bool isSaving = false;
    private List<Artist> allArtists = new();
    private SongDto newSongDto = EmptySong();
    // Row set up for both artists and remixers

    private class ArtistRow
    {
        public Guid Key { get; } = Guid.NewGuid();
        public int? SelectedId { get; set; } = null;
    }

    private List<ArtistRow> artistRows = new() { new ArtistRow() };
    private List<ArtistRow> remixerRows = new() { new ArtistRow() };

    private static SongDto EmptySong() => new SongDto
    {
        //Init required members
        Title = String.Empty,
        ArtistIds = new List<int>(),
        Length = String.Empty,
        Genre = String.Empty,
    };

    void AddArtistRows()
    {
        if (artistRows.Count < MaxRows) artistRows.Add(new ArtistRow());
        else WarnRowLimit();
    }
    void RemoveArtistRow(Guid key)
    {
        if(artistRows.Count == 1) return;
        var idx = artistRows.FindIndex(r => r.Key == key);
        if (idx >= 0) artistRows.RemoveAt(idx);

    }

    void AddRemixRows()
    {
        if (remixerRows.Count < MaxRows) remixerRows.Add(new ArtistRow());
        else WarnRowLimit();
    }
    void RemoveRemixRow(Guid key)
    {
        if (remixerRows.Count == 1) return;
        remixerRows.RemoveAll(r => r.Key == key);
    }

    void WarnRowLimit() => ToastService.ShowToast($"ADVARSEL: Maks {MaxRows} artister per låt.", ToastType.Warning);


    protected override async Task OnInitializedAsync()
    {
        var result = await ArtistService.GetAllArtistsAsync();

        if (result.IsSuccess)
        {
            allArtists = result.Value
                .OrderBy(a => a.Name)
                .ToList();
        }
    }

    private async Task SaveSong()
    {
        if (isSaving)
            return;

        // Sync toggles to DTO before saving
        newSongDto.Played = playedIsToggled;
        newSongDto.Wanted = wantedIsToggled;

        // New 22.09.25: On Save - Filter Non-Null Selections
        newSongDto.ArtistIds = artistRows
            .Where(r => r.SelectedId.HasValue)
            .Select(r => r.SelectedId!.Value)
            .Distinct()
            .ToList();

        // Turning the Remix switch off drops any remix artists chosen earlier
        newSongDto.RemixArtistIds = remixIsToggled
            ? remixerRows
                .Where(r => r.SelectedId.HasValue)
                .Select(r => r.SelectedId!.Value)
                .Distinct()
                .ToList()
            : new();

        if (newSongDto.ArtistIds.Count == 0)
        {
            ToastService.ShowToast("ADVARSEL: Velg minst én artist.", ToastType.Warning);
            return;
        }

        // Calling service after DTOs are ready
        isSaving = true;
        Result<Song> result;
        try
        {
            result = await SongService.CreateNewSongAsync(newSongDto);
        }
        finally
        {
            isSaving = false;
        }

        if (result.IsSuccess)
        {
            ToastService.ShowToast($"SUKSESS! {Shorten(result.Value.Title)} ble opprettet! ", ToastType.Success);

            // Resetting the form
            artistRows = new() {new ArtistRow()};
            remixerRows = new() {new ArtistRow()};
            playedIsToggled = false;
            wantedIsToggled = false;
            remixIsToggled = false;
            newSongDto = EmptySong();
        }
        else if (result.Error.Contains("already exists", StringComparison.OrdinalIgnoreCase))
        {
            //Displaying the first artist in instances where there are multiple, defaults to "Ukjent artist" when there are none
            var artistName = allArtists
                .FirstOrDefault(a => newSongDto.ArtistIds.Contains(a.ArtistId))?.Name ?? "(Ukjent artist)";

            ToastService.ShowToast($"ADVARSEL: {Shorten(newSongDto.Title)} av {artistName} finnes allerede.", ToastType.Warning);
        }
        else if (result.Error.Contains("no longer exist", StringComparison.OrdinalIgnoreCase))
        {
            ToastService.ShowToast("ADVARSEL: En av de valgte artistene finnes ikke lenger. Last siden på nytt.", ToastType.Warning);
        }
        else
        {
            ToastService.ShowToast("FEIL: En ukjent feil oppstod. Prøv igjen senere.", ToastType.Error);
        }
    }

    private static string Shorten(string title) => title.Length > 30 ? title[..30] + "..." : title;
}

