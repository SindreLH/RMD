@page
@model RMD.GUI.Pages.ErrorModel
@using RMD.GUI.Infrastructure
@{
    var theme = ThemeCatalog.Normalize(HttpContext.Request.Cookies[ThemeCatalog.CookieName]);
}

<!DOCTYPE html>
<html lang="nb" data-theme="@theme">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>RMD | Feil</title>
    <link href="~/css/bootstrap/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/themes.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/layout.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/components.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>

<body style="background-image: var(--rmd-bg-image); display: flex; align-items: center; justify-content: center; padding: var(--rmd-gutter);">
    <main class="rmd-auth-card text-center">
        <h1>Noe gikk galt</h1>
        <p>Det oppstod en feil under behandlingen av forespørselen. Prøv igjen om litt.</p>

        @if (Model.ShowRequestId)
        {
            <p class="rmd-muted">Referanse: <code>@Model.RequestId</code></p>
        }

        <a href="/dashboard" class="btn btn-success">Til dashboardet</a>
    </main>
</body>

</html>
