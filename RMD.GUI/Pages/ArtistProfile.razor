@page "/Artist/{ArtistId:int}"
@using RMD.GUI.Pages.Components.Modals;
@using RMD.Data.Models
@using RMD.Business.Services;
@inject IArtistService ArtistService;

<PageTitle>RMD | @artist?.Name - Artist Page</PageTitle>

@if (editModalVisible)
{
	<EditArtistModal IsVisible="editModalVisible" OnClose="ToggleEditModal"/>
}

@if(deleteModalVisible){
	<WarningModalArtistDeletion IsVisible="deleteModalVisible" OnClose="ToggleDeleteModal"/>
}

@if(artist == null)
{
	<p style="color: red;">No artist at this ID...</p>
	return;
}

<div class="header_wrapper">

	<div class="header_contents">

		<img src="@(artist?.ProfilePicUrl ?? "images/no_artist_image.png")"
			 alt="Artist Press Picture"
			 class="artist_profile_pic" />
		

		<h3>@artist?.Name</h3>
	</div>
</div>


<div class="table_and_box">
	<div class="table-container">
		<table class="table table-bordered table-dark table-striped table-hover">
			<thead class="thead-light">
				<tr>
					<th>
						Tittel
					</th>

					<th>
						Remixartist
					</th>

					<th>
						Lengde
					</th>
				</tr>

			</thead>

			<tbody>
				<tr>
					<td class="text-truncate" style="max-width: 20px">Load artists songs here</td>
					<td class="text-truncate" style="max-width: 20px">Remix Artist here</td>
					<td>Track length</td>
				</tr>

			</tbody>
		</table>
	</div>


	<div class="info_box">


		<div class="info_box_text">

			<h4><b>Artistinformasjon</b></h4>

			<div class="text_control">
				<p><b>@artist?.Nationality</b></p>
			</div>
			<div class="text_control">
				<p><b>🙌Hands Up</b></p>
			</div>
			<div class="text_control">
				<a href="@artist?.FacebookUrl">
					<img src="images/fb_icon.png" class="socials_icons" />
					Facebook
				</a>
				<br>
				<br>
			</div>
			<div class="text_control">
				<a href="@artist?.SoundcloudUrl">
					<img src="images/sc_icon.png" class="socials_icons" />
					Soundcloud
				</a>
				<br>
				<br>
			</div>
			<div class="text_control">
				<a href="@artist?.DiscogsUrl">
					<img src="images/discogs_icon.png" class="socials_icons" />
					Discogs
				</a>
			</div>
		</div>

		<div class="info_box_buttons">

			<div class="button_wrapper">
				<div class="edit_button">
					<button type="button" @onclick="ToggleEditModal" class="btn btn-warning fixed-width">
						<i class="bi bi-pencil"></i> Rediger artist
					</button>
				</div>

				<div class="delete_button">
					<button type="button" @onclick="ToggleDeleteModal" class="btn btn-danger fixed-width">
						<i class="bi bi-trash3"></i> Fjern artist
					</button>
				</div>
			</div>
		</div>

	</div>

</div>



@code {
	private bool isLoading = false;
	private bool isSelected = false;
	private bool editModalVisible = false;
	private bool deleteModalVisible = false;
	private bool editArtistModalVisible = false;

	private Artist? artist;
	[Parameter] public int ArtistId { get; set; }


	protected override async Task OnParametersSetAsync()
	{
		var result = await ArtistService.GetArtistById(ArtistId);

		if (result.IsSuccess)
		{
			artist = result.Value;
			isLoading = false;
		}

		else
		{
			isLoading = true;
			Console.WriteLine("No artist found by this ID.");
		}
	}

	private void ToggleEditModal()
	{
		editModalVisible = !editModalVisible;
	}

	private void ToggleDeleteModal()
	{
		deleteModalVisible = !deleteModalVisible;
	}
}
