@page "/Artist/{ArtistId:int}"
@using RMD.GUI.Pages.Components.Modals;
@using RMD.Data.Models
@using RMD.Business.Services;
@inject IArtistService ArtistService;
@inject ISongService SongService;
@inject NavigationManager Navigation;

<PageTitle>RMD | @artist?.Name - Artist Page</PageTitle>

@if (editModalVisible)
{
	<EditArtistModal IsVisible="editModalVisible" 
	OnClose="ToggleEditModal"
	OnSave="OnArtistEdited"
	Artist="artist"/>
}

@if(deleteModalVisible){
	<WarningModalArtistDeletion IsVisible="deleteModalVisible" 
	OnClose="ToggleDeleteModal"
	Artist="artist"
	OnDelete="OnArtistDeleted"
	/>
}


<div class="header_wrapper">

	<div class="header_contents">

		<img src="@(artist?.ProfilePicUrl ?? "images/no_artist_image.png")"
		alt="Artist Press Picture"
		class="artist_profile_pic" />


		<h3>@artist?.Name</h3>
	</div>
</div>

<div class="table_and_box">
	<div class="table-container">
		<table class="table table-bordered table-dark table-striped table-hover">
			<thead class="thead-light">
				<tr>
					<th>
						Tittel
					</th>

					<th>
						Remixartist
					</th>

					<th>
						Lengde
					</th>
				</tr>

			</thead>

			@if (artistHasNoSongs == false)
			{
				@foreach (var song in songs?.Value ?? Enumerable.Empty<Song>())
				{
					<tbody>
						<tr>
							<td class="text-truncate" style="max-width: 20px">@song.Title</td>
							<td class="text-truncate" style="max-width: 20px">@song.RemixArtist</td>
							<td>@song.Length</td>
						</tr>

					</tbody>
				}
			}

			
		</table>

		@if (artistHasNoSongs == true)
		{
			<div class="load_container">
					<div class="load_contents">
						<p class="load_text">Denne artisten har ingen låter enda...</p>
					</div>
				</div>
		}

		@if (artist == null)
			{
				<div class="load_container">
					<div class="load_contents">
						<img src="/images/Loader.gif" alt="Loading..." class="load_spinner" />
						<p class="load_text">Laster inn låter...</p>
					</div>
				</div>
			}
	</div>

	<div class="info_box">


		<div class="info_box_text">

			<h4><b>Artistinformasjon</b></h4>

			<div class="text_control">
				<p><b>@artist?.Nationality</b></p>
			</div>
			<div class="text_control">
				<p><b>🎵@artist?.Songs?.FirstOrDefault()?.Genre</b></p>
			</div>
			<div class="text_control">
				<a href="@artist?.FacebookUrl">
					<img src="images/fb_icon.png" class="socials_icons" />
					Facebook
				</a>
				<br>
				<br>
			</div>
			<div class="text_control">
				<a href="@artist?.SoundcloudUrl">
					<img src="images/sc_icon.png" class="socials_icons" />
					Soundcloud
				</a>
				<br>
				<br>
			</div>
			<div class="text_control">
				<a href="@artist?.DiscogsUrl">
					<img src="images/discogs_icon.png" class="socials_icons" />
					Discogs
				</a>
			</div>
		</div>

		<div class="info_box_buttons">

			<div class="button_wrapper">
				<div class="edit_button">
					<button type="button" @onclick="ToggleEditModal" class="btn btn-warning fixed-width">
						<i class="bi bi-pencil"></i> Rediger artist
					</button>
				</div>

				<div class="delete_button">
					<button type="button" @onclick="ToggleDeleteModal" class="btn btn-danger fixed-width">
						<i class="bi bi-trash3"></i> Fjern artist
					</button>
				</div>
			</div>
		</div>

	</div>
</div>

@code {
	private bool isLoading = false;
	private bool artistHasNoSongs = false;
	private bool isSelected = false;
	private bool editModalVisible = false;
	private bool deleteModalVisible = false;
	private bool editArtistModalVisible = false;
	private bool emptyDbModalVisible = false;
	private Result<IEnumerable<Artist>>? artists;
	private Result<IEnumerable<Song>>? songs;
	private Artist? artist;
	[Parameter] public int ArtistId { get; set; }

	private void ToggleEditModal()
	{
		editModalVisible = !editModalVisible;
	}

	private void ToggleDeleteModal()
	{
		deleteModalVisible = !deleteModalVisible;
	}

	protected override async Task OnParametersSetAsync()
	{
		var result = await ArtistService.GetArtistById(ArtistId);

		if (result.IsSuccess)
		{
			artist = result.Value;
			isLoading = false;
		}

		else
		{
			isLoading = true;
			Console.WriteLine("No artist found by this ID.");
		}
	}

	protected override async Task OnInitializedAsync()
	{

		await Task.Delay(300);

		var songsByArtist = await SongService.GetSongsByArtistIdAsync(ArtistId);
		artistHasNoSongs = false;
		isLoading = false;


		if (!songsByArtist.IsSuccess)
		{
			artistHasNoSongs = true;
			isLoading = true;
			Console.WriteLine(songsByArtist.Error);
			return;
		}

		songs = Result<IEnumerable<Song>>.Success(songsByArtist.Value);



		if(songs.Value == null)
		{
			isLoading = true;
			artistHasNoSongs = true;
			Console.WriteLine(songs.Error);
			return;
		}



	}

	private async Task OnArtistDeleted(Artist artist)
	{
		var result = await ArtistService.DeleteArtistByIdAsync(artist.ArtistId);

		if (result.IsSuccess)
		{
			artists = await ArtistService.GetAllArtistsAsync();

			deleteModalVisible = false;
			isLoading = false;

			Navigation.NavigateTo("/Archive");
		}
		else
		{
			Console.WriteLine(result.Error);
		}

	}

	private async Task OnArtistEdited(Artist updatedArtist)
	{
		var dto = new RMD.Data.Models.DTO.ArtistDto
			{
				Name = updatedArtist.Name,
				Nationality = updatedArtist.Nationality,
				FacebookUrl = updatedArtist.FacebookUrl,
				SoundcloudUrl = updatedArtist.SoundcloudUrl,
				ProfilePicUrl = updatedArtist.ProfilePicUrl,
				DiscogsUrl = updatedArtist.DiscogsUrl
			};

		var result = await ArtistService.UpdateArtistByIdAsync(updatedArtist.ArtistId, dto);

		if (result.IsSuccess)
		{
			// // Optionally reload songs from service
			// artist = await ArtistService.GetAllArtistsAsync();
			isSelected = false;
			editModalVisible = false;
		}
		else
		{
			// Handle error
			Console.WriteLine(result.Error);
		}
	}
}
