@page "/Artist/{ArtistId:int}"
@attribute [Authorize]

@using RMD.GUI.Pages.Components.Modals;
@using RMD.Data.Models
@using RMD.Business.Services;
@using RMD.GUI.Pages;
@inject IArtistService ArtistService;
@inject ISongService SongService;
@inject ToastService ToastService;
@inject NavigationManager Navigation;

<PageTitle>RMD | @artist?.Name</PageTitle>


@if (editModalVisible)
{
	<EditArtistModal IsVisible="editModalVisible"
	OnClose="ToggleEditModal"
	OnSave="OnArtistEdited"
	Artist="artist"/>
}

@if(deleteModalVisible){
	<WarningModalArtistDeletion IsVisible="deleteModalVisible"
	OnClose="ToggleDeleteModal"
	Artist="artist"
	SongsLeftWithoutArtist="songsLeftWithoutArtist"
	OnDelete="OnArtistDeleted"/>
}


@if (!notFound)
{
	<div class="rmd-page">
		<section class="artist-hero">
			<img src="@(SafeUrl.ForHref(artist?.ProfilePicUrl) ?? "images/no_artist_image.png")"
				 alt=""
				 class="artist-hero__pic" />
			<h1 class="artist-hero__name">@artist?.Name</h1>
		</section>

		<div class="artist-layout">
			<section class="rmd-panel artist-info" aria-label="Artistinformasjon">
				<h2 class="h4">Artistinformasjon</h2>

				<dl class="artist-info__facts">
					<dt>Nasjonalitet</dt>
					<dd>@artist?.Nationality</dd>

					@if (genres.Length > 0)
					{
						<dt>Sjanger</dt>
						<dd>🎵 @genres</dd>
					}

					<dt>Låter</dt>
					<dd>@songs.Count</dd>
				</dl>

				@if (SocialLinks.Any())
				{
					<ul class="artist-info__links">
						@foreach (var (label, icon, url) in SocialLinks)
						{
							<li>
								<a href="@url" target="_blank" rel="noopener noreferrer">
									<img src="@icon" alt="" class="socials_icons" />
									@label
								</a>
							</li>
						}
					</ul>
				}

				<div class="rmd-cluster">
					<button type="button" @onclick="ToggleEditModal" class="btn btn-warning">
						<i class="bi bi-pencil"></i> Rediger artist
					</button>
					<button type="button" @onclick="ToggleDeleteModal" class="btn btn-danger">
						<i class="bi bi-trash3"></i> Fjern artist
					</button>
				</div>
			</section>

			<section class="artist-songs" aria-label="Låter">
				@if (isLoading)
				{
					<div class="rmd-loader">
						<img src="/images/Loader.gif" alt="" />
						<p>Laster inn låter...</p>
					</div>
				}
				else if (songs.Count == 0)
				{
					<div class="rmd-empty">
						<p>Artisten er ikke tilknyttet noen låter ennå...</p>
					</div>
				}
				else
				{
					<div class="rmd-table-wrap">
						<table class="table table-bordered table-dark table-striped table-hover rmd-table rmd-table--stack">
							<thead>
								<tr>
									<th>Tittel</th>
									<th>Lengde</th>
									<th>Spilt i EP</th>
									<th>Kilde URL</th>
									<th>Lagret</th>
									<th>Favoritt</th>
								</tr>
							</thead>

							<tbody>
								@foreach (var song in songs)
								{
									var songUrl = SafeUrl.ForHref(song.WantedSongUrl);
									<tr>
										<td class="rmd-cell-title rmd-truncate" style="--rmd-truncate-max: 26rem" title="@song.Title">@song.Title</td>
										<td data-label="Lengde">@song.Length</td>
										<td data-label="Spilt i EP">@song.PlayedInEp</td>
										<td data-label="Kilde">@if (songUrl != null)
											{
												<a href="@songUrl" target="_blank" rel="noopener noreferrer" title="@songUrl">🔗</a>
											}</td>
										<td data-label="Lagret">@(song.Stored ? "✅" : "❌")</td>
										<td data-label="Favoritt">@(song.Favorite ? "⭐" : "❌")</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</section>
		</div>
	</div>
}

@code {
	private bool isLoading = true;
	private bool notFound = false;
	private bool editModalVisible = false;
	private bool deleteModalVisible = false;
	private int songsLeftWithoutArtist;
	private List<Song> songs = new();
	private string genres = "";
	private Artist? artist;
	private int? loadedArtistId;
	[Parameter] public int ArtistId { get; set; }

	/// <summary>Only links that are real http(s) urls are shown.</summary>
	private IEnumerable<(string Label, string Icon, string Url)> SocialLinks =>
		new (string Label, string Icon, string? Url)[]
		{
			("Facebook", "images/fb_icon.png", SafeUrl.ForHref(artist?.FacebookUrl)),
			("Soundcloud", "images/sc_icon.png", SafeUrl.ForHref(artist?.SoundcloudUrl)),
			("Discogs", "images/discogs_icon.png", SafeUrl.ForHref(artist?.DiscogsUrl)),
		}
		.Where(l => l.Url != null)
		.Select(l => (l.Label, l.Icon, l.Url!));

	private void ToggleEditModal()
	{
		editModalVisible = !editModalVisible;
	}

	private async Task ToggleDeleteModal()
	{
		if (!deleteModalVisible && artist != null)
		{
			var count = await ArtistService.CountSongsLeftWithoutArtistAsync(artist.ArtistId);
			songsLeftWithoutArtist = count.IsSuccess ? count.Value : 0;
		}

		deleteModalVisible = !deleteModalVisible;
	}

	// Runs on first load and whenever the route moves to another artist (Blazor reuses the component)
	protected override async Task OnParametersSetAsync()
	{
		if (loadedArtistId == ArtistId)
			return;

		loadedArtistId = ArtistId;
		isLoading = true;
		notFound = false;
		artist = null;
		songs = new();
		genres = "";

		var result = await ArtistService.GetArtistById(ArtistId);

		if (!result.IsSuccess || result.Value == null)
		{
			notFound = true;
			Navigation.NavigateTo("/notfound", replace: true);
			return;
		}

		artist = result.Value;
		await LoadSongsAsync();
		isLoading = false;
	}

	private async Task LoadSongsAsync()
	{
		var songsByArtist = await SongService.GetSongsByArtistIdAsync(ArtistId);
		songs = songsByArtist.IsSuccess ? songsByArtist.Value.ToList() : new();

		genres = string.Join(", ", songs
			.Select(s => s.Genre)
			.Where(g => !string.IsNullOrWhiteSpace(g))
			.GroupBy(g => g)
			.OrderByDescending(g => g.Count())
			.Select(g => g.Key));
	}

	private async Task OnArtistDeleted(Artist artistToDelete)
	{
		var result = await ArtistService.DeleteArtistByIdAsync(artistToDelete.ArtistId);

		if (result.IsSuccess)
		{
			ToastService.ShowToast($"SUKSESS! {Shorten(artistToDelete.Name)} ble fjernet.", ToastType.Success);
			deleteModalVisible = false;
			Navigation.NavigateTo("/Archive");
		}
		else
		{
			ToastService.ShowToast("FEIL: Kunne ikke slette artisten. " + result.Error, ToastType.Error);
		}

	}

	private async Task OnArtistEdited(Artist updatedArtist)
	{
		var dto = new RMD.Data.Models.DTO.ArtistDto
			{
				Name = updatedArtist.Name,
				Nationality = updatedArtist.Nationality,
				FacebookUrl = updatedArtist.FacebookUrl,
				SoundcloudUrl = updatedArtist.SoundcloudUrl,
				ProfilePicUrl = updatedArtist.ProfilePicUrl,
				DiscogsUrl = updatedArtist.DiscogsUrl
			};

		var result = await ArtistService.UpdateArtistByIdAsync(updatedArtist.ArtistId, dto);

		if (result.IsSuccess)
		{
			artist = result.Value;
			editModalVisible = false;
			ToastService.ShowToast($"SUKSESS! {Shorten(artist.Name)} ble endret!", ToastType.Success);
		}
		else
		{
			ToastService.ShowToast("FEIL: Kunne ikke lagre endringene. " + result.Error, ToastType.Error);
		}
	}

	private static string Shorten(string name) => name.Length > 18 ? name[..18] + "..." : name;
}
