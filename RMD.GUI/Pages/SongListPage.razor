@page "/Songs"
@using RMD.GUI.Pages.Components.Modals;
@using RMD.Data.Models;
@using RMD.Business.Services
@inject ISongService SongService

<PageTitle>RMD | Songs</PageTitle>

@if (editModalVisible)
{
	<EditSongModal IsVisible = "editModalVisible" onclose="ToggleEditModal"/>
}

@if (deleteModalVisible)
{
	<WarningModalSongDeletion IsVisible="deleteModalVisible" OnClose="ToggleDeleteModal"/>
}


<div class="search-button-checkbox-wrapper">

	<div class="input-group mb-3 searchbar">
		<input
		type="text"
		class="form-control search"
		placeholder="Søk etter låt"
		value="@searchString"
		@oninput="OnSearchInputChanged"/>
	</div>

	<div class="checkboxes">
		<div class="form-check form-check-inline">
			<input class="form-check-input" type="checkbox" id="playedFilter" @onchange="async e => await SetTableFilters(SongFilterType.Played, ((ChangeEventArgs)e).Value is true)" />
			<label class="form-check-label" for="playedFilter">Avspilt</label>
		</div>

		<div class="form-check form-check-inline">
			<input class="form-check-input" type="checkbox" id="playedFilter" @onchange="async e => await SetTableFilters(SongFilterType.Stored, ((ChangeEventArgs)e).Value is true)" />
			<label class="form-check-label" for="playedFilter">Lagret</label>
		</div>

		<div class="form-check form-check-inline">
			<input class="form-check-input" type="checkbox" id="wantedFilter" @onchange="async e => await SetTableFilters(SongFilterType.Wanted, ((ChangeEventArgs)e).Value is true)" />
			<label class="form-check-label">Ønsket</label>
		</div>

		<div class="form-check form-check-inline">
			<input class="form-check-input" type="checkbox" id="extendedMixFilter" @onchange="async e => await SetTableFilters(SongFilterType.ExtendedMix, ((ChangeEventArgs)e).Value is true)" />
			<label class="form-check-label">Extended Mix</label>
		</div>

		<div class="form-check form-check-inline">
			<input class="form-check-input" type="checkbox" id="favoriteFilter" @onchange="async e => await SetTableFilters(SongFilterType.Favorite, ((ChangeEventArgs)e).Value is true)" />
			<label class="form-check-label">Favoritt</label>
		</div>
	</div>

	@if (isSelected)
	{
		<div class="button_wrapper">
			<div class="edit_button">
				<button type="button" @onclick="ToggleEditModal" class="btn btn-warning fixed-width">
					<i class="bi bi-pencil"></i> Rediger låt
				</button>
			</div>

			<div class="delete_button">
				<button type="button" @onclick="ToggleDeleteModal" class="btn btn-danger fixed-width">
					<i class="bi bi-trash3"></i> Fjern låt
				</button>
			</div>
		</div>
	}


</div>

@if (songs == null)
{
	<p>Loading songs...</p>
}

@if (!string.IsNullOrWhiteSpace(songs?.Error))
{
	<p class="text-danger">@songs.Error</p>
}

<div class="table-container">
	<table class="table table-bordered table-dark table-striped table-hover">
		<thead class="thead-light">
			<tr>
				<th>
					#
				</th>

				<th>
					Tittel
				</th>

				<th>
					Artist
				</th>

				<th>
					Remixer
				</th>

				<th>
					Lengde
				</th>

				<th>
					Sjanger
				</th>

				<th>
					Favoritt
				</th>

				<th>
					Extended
				</th>

				<th>
					Spilt
				</th>

				<th>
					Episode
				</th>

				<th>
					Lagret
				</th>

				<th>
					Ønsket
				</th>

				<th>
					Låt Url
				</th>
			</tr>

		</thead>

		@if (emptyDbModalVisible)
		{
			<ErrorModalEmptyDb IsVisible="true" OnClose="ToggleEmptyDbModal" />
		}

		@foreach (var song in (isFiltering ? filteredSongs : songs?.Value ?? Enumerable.Empty<Song>())){
			<tbody>
				<tr @onclick="() => isSelected = !isSelected">
					<td>@song.SongId</td>
					<td class="text-truncate"
					style="max-width: 200px"
					title="@song.Title"
					>@song.Title</td>
					<td>@song.Artist</td>
					<td>@song.RemixArtist</td>
					<td>@song.Length</td>
					<td>@song.Genre</td>
					<td>@(song.Favorite ? "⭐" : "❌")</td>
					<td>@(song.ExtendedMix ? "✅" : "❌")</td>
					<td>@(song.Played ? "✅" : "❌")</td>
					<td>@song.PlayedInEp</td>
					<td>@(song.Stored ? "✅" : "❌")</td>
					<td>@(song.Wanted ? "✅" : "❌")</td>
					<td class="text-truncate" style="max-width: 200px">
						<a href="@song.WantedSongUrl"
						target="_blank"
						rel="noopener noreferrer"
						title="@song.WantedSongUrl">
							@song.WantedSongUrl
						</a>
					</td>
				</tr>
			</tbody>
		}
	</table>
</div>


@code {
	private Result<IEnumerable<Song>>? songs;
	private IEnumerable<Song> filteredSongs = new List<Song>();

	private bool isSelected = false;
	private bool editModalVisible = false;
	private bool deleteModalVisible = false;
	private bool emptyDbModalVisible = false;

	private string searchString = string.Empty;
	private bool isFiltering = false;
	private bool? favoriteFilter = null;
	private bool? extendedMixFilter = null;
	private bool? playedFilter = null;
	private bool? storedFilter = null;
	private bool? wantedFilter = null;

	public enum SongFilterType
	{
		Played,
		Stored,
		Wanted, 
		ExtendedMix,
		Favorite
	}


	private void ToggleEditModal()
	{
		editModalVisible = !editModalVisible;
	}

	private void ToggleEmptyDbModal()
	{
		emptyDbModalVisible = !emptyDbModalVisible;

	}

	private void ToggleDeleteModal()
	{
		deleteModalVisible = !deleteModalVisible;
	}

	private async Task OnSearchInputChanged(ChangeEventArgs e)
	{
		searchString = e.Value?.ToString() ?? "";
		await LoadFilteredSongsAsync();
	}

	protected override async Task OnInitializedAsync()
	{
		songs = await SongService.GetAllSongsAsync();

		if (songs?.Value == null || !songs.Value.Any())
		{
			emptyDbModalVisible = true;
		}
	}

	private async Task LoadFilteredSongsAsync()
	{
		var result = await SongService.GetAllSongsWithFiltersAsync(
			ExtendedMix: extendedMixFilter,
			RadioMix: null,
			Favorite: favoriteFilter,
			Played: playedFilter,
			Stored: storedFilter,
			Wanted: wantedFilter
		);

		isFiltering = true;

		IEnumerable<Song> filtered = result.IsSuccess ? result.Value : Enumerable.Empty<Song>();

		if (!string.IsNullOrWhiteSpace(searchString))
		{
			string lowerSearch = searchString.ToLower();

			filtered = filtered.Where(song =>
				(song.Title?.ToLower().Contains(lowerSearch) ?? false) ||
				(song.Artist?.ToLower().Contains(lowerSearch) ?? false) ||
				(song.RemixArtist?.ToLower().Contains(lowerSearch) ?? false)
			);
		}

		filteredSongs = filtered.ToList();

		emptyDbModalVisible = !filteredSongs.Any();
	}

	private async Task SetTableFilters(SongFilterType filterType, bool isChecked)
	{
		switch (filterType)
		{
			case SongFilterType.Played:
				playedFilter = isChecked ? true : null;
				break; 

			case SongFilterType.Stored:
				storedFilter = isChecked ? true : null;
				break;

			case SongFilterType.Wanted:
				wantedFilter = isChecked ? true : null;
				break;

			case SongFilterType.Favorite:
				favoriteFilter = isChecked ? true : null;
				break;

			case SongFilterType.ExtendedMix:
				extendedMixFilter = isChecked ? true : null;
				break;
		}

		await LoadFilteredSongsAsync();
	}

}
