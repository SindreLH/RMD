@page "/Songs"
@using RMD.GUI.Pages.Components.Modals;
@using RMD.Data.Models;
@using RMD.Business.Services
@inject ISongService SongService

<PageTitle>RMD | Songs</PageTitle>

@if (editModalVisible)
{
	<EditSongModal IsVisible = "editModalVisible" onclose="ToggleEditModal"/>
}

@if (deleteModalVisible)
{
	<WarningModalSongDeletion IsVisible="deleteModalVisible" OnClose="ToggleDeleteModal"/>
}


<div class="search-button-checkbox-wrapper">

	<div class="input-group mb-3 searchbar">
		<input type="text"
		class="form-control search"
		placeholder="Søk etter låt"
		aria-label="Søk etter låt"
		@bind="searchString"
		@bind:event="oninput"/>
		<span class="input-group-text" id="basic-addon2">
			<i class="bi bi-search"></i>
		</span>
	</div>

	<div class="checkboxes">
		<div class="form-check form-check-inline">
			<input class="form-check-input" type="checkbox" id="playedFilter" @onchange="async _ => await FilterPlayed(true)" />
			<label class="form-check-label" for="playedFilter">Avspilt</label>
		</div>

		<div class="form-check form-check-inline">
			<input class="form-check-input" type="checkbox" id="storedFilter" @onchange="async _ => await FilterStored(true)">
			<label class="form-check-label">Lagret</label>
		</div>


		<div class="form-check form-check-inline">
			<input class="form-check-input" type="checkbox" id="wantedFilter" @onchange="async _ => await FilterWanted(true)">
			<label class="form-check-label">Ønsket</label>
		</div>

		<div class="form-check form-check-inline">
			<input class="form-check-input" type="checkbox" id="extendedMixFilter" @onchange="async _ => await FilterExtendedMix(true)">
			<label class="form-check-label">Extended Mix</label>
		</div>

		<div class="form-check form-check-inline">
			<input class="form-check-input" type="checkbox" id="favoriteFilter" @onchange="async _ => await FilterFavorite(true)">
			<label class="form-check-label">Favoritt</label>
		</div>

		<div class="form-check form-check-inline">
			<input class="form-check-input" type="checkbox" id="resetFilter" @onchange="ClearFilters">
			<label class="form-check-label">Nullstill filter</label>
		</div>
	</div>

	@if (isSelected)
	{
		<div class="button_wrapper">
			<div class="edit_button">
				<button type="button" @onclick="ToggleEditModal" class="btn btn-warning fixed-width">
					<i class="bi bi-pencil"></i> Rediger låt
				</button>
			</div>

			<div class="delete_button">
				<button type="button" @onclick="ToggleDeleteModal" class="btn btn-danger fixed-width">
					<i class="bi bi-trash3"></i> Fjern låt
				</button>
			</div>
		</div>
	}


</div>

@if (songs == null)
{
	<p>Loading...</p>
}
else if (!songs.Value.Any())
{
	<ErrorModalEmptyDb/>
}

@if (!string.IsNullOrWhiteSpace(songs?.Error))
{
	<p class="text-danger">@songs.Error</p>
}

<div class="table-container">
	<table class="table table-bordered table-dark table-striped table-hover">
		<thead class="thead-light">
			<tr>
				<th>
					#
				</th>

				<th>
					Tittel
				</th>

				<th>
					Artist
				</th>

				<th>
					Remixer
				</th>

				<th>
					Lengde
				</th>

				<th>
					Sjanger
				</th>

				<th>
					Favoritt
				</th>

				<th>
					Extended
				</th>

				<th>
					Spilt
				</th>

				<th>
					Episode
				</th>

				<th>
					Lagret
				</th>

				<th>
					Ønsket
				</th>

				<th>
					Låt Url
				</th>
			</tr>

		</thead>

		@*
				Check songs.Value for content.
				If songs is null, an empty collection is provided to avoid runtime errors.
			*@	

		@foreach (var song in (isFiltering ? filteredSongs : songs?.Value ?? Enumerable.Empty<Song>())){
			<tbody>
				<tr @onclick="() => isSelected = !isSelected">
					<td>@song.SongId</td>
					<td class="text-truncate"
					style="max-width: 200px"
					title="@song.Title"
					>@song.Title</td>
					<td>@song.Artist</td>
					<td>@song.RemixArtist</td>
					<td>@song.Length</td>
					<td>@song.Genre</td>
					<td>@(song.Favorite ? "⭐" : "❌")</td>
					<td>@(song.ExtendedMix ? "✅" : "❌")</td>
					<td>@(song.Played ? "✅" : "❌")</td>
					<td>@song.PlayedInEp</td>
					<td>@(song.Stored ? "✅" : "❌")</td>
					<td>@(song.Wanted ? "✅" : "❌")</td>
					<td class="text-truncate" style="max-width: 200px">
						<a href="@song.WantedSongUrl"
						target="_blank"
						rel="noopener noreferrer"
						title="@song.WantedSongUrl">
							@song.WantedSongUrl
						</a>
					</td>


				</tr>
			</tbody>
		}
	</table>
</div>


@code {
	private Result<IEnumerable<Song>>? songs;
	private IEnumerable<Song> filteredSongs = new List<Song>();
	private bool isSelected = false;
	private bool editModalVisible = false;
	private bool deleteModalVisible = false;
	private bool isFiltering = false;
	private bool? favoriteFilter = null;
	private bool? extendedMixFilter = null;
	private bool? playedFilter = null;
	private bool? storedFilter = null;
	private bool? wantedFilter = null;

	private string _searchString = string.Empty;
	private string searchString
	{
		get => _searchString;
		set
		{
			_searchString = value;
			_ = LoadFilteredSongsAsync();
		}
	}


	private void ToggleEditModal()
	{
		editModalVisible = !editModalVisible;
	}

	private void ToggleDeleteModal()
	{
		deleteModalVisible = !deleteModalVisible;
	}

	private async Task LoadFilteredSongsAsync()
	{
		var result = await SongService.GetAllSongsWithFiltersAsync(
			ExtendedMix: extendedMixFilter,
			RadioMix: null,
			Favorite: favoriteFilter,
			Played: playedFilter,
			Stored: storedFilter,
			Wanted: wantedFilter
		);

		isFiltering = true;
		var allSongs = result.IsSuccess ? result.Value : Enumerable.Empty<Song>();

		// filteredSongs = result.IsSuccess ? result.Value : Enumerable.Empty<Song>();
		filteredSongs = ApplySearchFilter(allSongs);
	}

	private IEnumerable<Song> ApplySearchFilter(IEnumerable<Song> songs)
	{
		if (string.IsNullOrWhiteSpace(searchString))
			return songs;

		return songs.Where(song =>
			(!string.IsNullOrEmpty(song.Title) && song.Title.Contains(searchString, StringComparison.OrdinalIgnoreCase)) ||
			(!string.IsNullOrEmpty(song.Artist) && song.Artist.Contains(searchString, StringComparison.OrdinalIgnoreCase)));
	}

	protected override async Task OnInitializedAsync()
	{
		songs = await SongService.GetAllSongsAsync();
	}

	private async Task FilterExtendedMix(bool? value)
	{
		extendedMixFilter = value;
		await LoadFilteredSongsAsync();
	}

	private async Task FilterFavorite(bool? value)
	{
		favoriteFilter = value;
		await LoadFilteredSongsAsync();
	}

	private async Task FilterPlayed(bool? value)
	{
		playedFilter = value;
		await LoadFilteredSongsAsync();
	}

	private async Task FilterStored(bool? value)
	{
		storedFilter = value;
		await LoadFilteredSongsAsync();
	}

	private async Task FilterWanted(bool? value)
	{
		wantedFilter = value;
		await LoadFilteredSongsAsync();
	}

	private async Task ClearFilters()
	{
		isFiltering = false;
		filteredSongs = Enumerable.Empty<Song>();

		favoriteFilter = null;
		extendedMixFilter = null;
		playedFilter = null;
		wantedFilter = null;
		storedFilter = null;

		searchString = string.Empty;

		songs = await SongService.GetAllSongsAsync();
	}

}
