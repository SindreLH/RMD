@page "/Songs"
@using RMD.GUI.Pages.Components.Modals;
@using RMD.Data.Models;
@using RMD.Data.Models.DTO;
@using RMD.Business.Services
@inject ISongService SongService
@inject ToastService ToastService

<PageTitle>RMD | Låter</PageTitle>

@if (editModalVisible)
{
	<EditSongModal IsVisible = "editModalVisible" 
	OnClose="@ToggleEditModal"
	Song="selectedSong"
	OnSave="HandleSaveAsync"/>
}

@if (deleteModalVisible)
{
	<WarningModalSongDeletion IsVisible="deleteModalVisible" 
		OnClose="ToggleDeleteModal"
		Song="selectedSong"
		OnDelete="OnSongDeleted"
		/>
}

@if (emptyDbModalVisible)
{
	<ErrorModalEmptyDb IsVisible="true" OnClose="ToggleEmptyDbModal" />
}

<div class="search-button-checkbox-wrapper">

	<div class="input-group mb-3 searchbar">
		<input
		type="text"
		class="form-control search"
		placeholder="Søk etter låt"
		value="@searchString"
		@oninput="OnSearchInputChanged"/>
	</div>

	<div class="checkboxes">
		<div class="form-check form-check-inline">
			<input class="form-check-input" type="checkbox" id="playedFilter" @onchange="async e => await SetTableFilters(SongFilterType.Played, ((ChangeEventArgs)e).Value is true)" />
			<label class="form-check-label" for="playedFilter">Avspilt</label>
		</div>

		<div class="form-check form-check-inline">
			<input class="form-check-input" type="checkbox" id="playedFilter" @onchange="async e => await SetTableFilters(SongFilterType.Stored, ((ChangeEventArgs)e).Value is true)" />
			<label class="form-check-label" for="playedFilter">Lagret</label>
		</div>

		<div class="form-check form-check-inline">
			<input class="form-check-input" type="checkbox" id="wantedFilter" @onchange="async e => await SetTableFilters(SongFilterType.Wanted, ((ChangeEventArgs)e).Value is true)" />
			<label class="form-check-label">Ønsket</label>
		</div>

		<div class="form-check form-check-inline">
			<input class="form-check-input" type="checkbox" id="extendedMixFilter" @onchange="async e => await SetTableFilters(SongFilterType.ExtendedMix, ((ChangeEventArgs)e).Value is true)" />
			<label class="form-check-label">Extended Mix</label>
		</div>

		<div class="form-check form-check-inline">
			<input class="form-check-input" type="checkbox" id="favoriteFilter" @onchange="async e => await SetTableFilters(SongFilterType.Favorite, ((ChangeEventArgs)e).Value is true)" />
			<label class="form-check-label">Favoritt</label>
		</div>
	</div>

	@if (isSelected)
	{
		<div class="button_wrapper">
			<div class="edit_button">
				<button type="button" @onclick="ToggleEditModal" class="btn btn-warning fixed-width">
					<i class="bi bi-pencil"></i> Rediger låt
				</button>
			</div>

			<div class="delete_button">
				<button type="button" @onclick="ToggleDeleteModal" class="btn btn-danger fixed-width">
					<i class="bi bi-trash3"></i> Fjern låt
				</button>
			</div>
		</div>
	}

</div>

@if (!string.IsNullOrWhiteSpace(songs?.Error))
{
	<p class="text-danger">@songs.Error</p>
}

<div class="table-container">
	<table class="table table-bordered table-dark table-striped table-hover">
		<thead class="thead-light">
			<tr>
				<th>#</th>
				<th>Tittel</th>
				<th>Artist</th>
				<th>Remixer</th>
				<th>Lengde</th>
				<th>Sjanger</th>
				<th>Favoritt</th>
				<th>Extended</th>
				<th>Episode</th>
				<th>Lagret</th>
				<th>Kilde</th>
			</tr>
		</thead>

		<tbody>
			@foreach (var song in (isFiltering ? filteredSongs : songs?.Value ?? Enumerable.Empty<Song>()))
			{
				<tr @onclick="() => SelectSong(song)" class="@(selectedSong?.SongId == song.SongId ? "selected-row" : "")">
					<td>@song.SongId</td>
					<td class="text-truncate" style="max-width: 200px" title="@song.Title">@song.Title</td>
					<td>
						@if (song.Artists != null && song.Artists.Any())
						{
							@string.Join(", ", song.Artists.Select(a => a.Name))
						}
						else
						{
							<em>Ingen artister</em>
						}
					</td>
					<td>@song.RemixArtist</td>
					<td>@song.Length</td>
					<td>@song.Genre</td>
					<td>@(song.Favorite ? "⭐" : "❌")</td>
					<td>@(song.ExtendedMix ? "✅" : "❌")</td>
					<td>@song.PlayedInEp</td>
					<td>@(song.Stored ? "✅" : "❌")</td>
					<td class="text-truncate" style="max-width: 200px">
						<a href="@song.WantedSongUrl" target="_blank" rel="noopener noreferrer" title="@song.WantedSongUrl">
							@song.WantedSongUrl
						</a>
					</td>
				</tr>
			}
		</tbody>
	</table>

	@if (songs == null)
	{
		<div class="load_container">
			<div class="load_contents">
				<img src="/images/Loader.gif" alt="Loading..." class="load_spinner" />
				<p class="load_text">Laster inn låter...</p>
			</div>
		</div>
	}

</div>


@code {
	private Result<IEnumerable<Song>>? songs;
	private IEnumerable<Song> filteredSongs = new List<Song>();

	private bool isSelected = false;
	private bool editModalVisible = false;
	private bool deleteModalVisible = false;
	private bool emptyDbModalVisible = false;

	private Song? selectedSong;
	private string searchString = string.Empty;
	private bool isFiltering = false;
	private bool? favoriteFilter = null;
	private bool? extendedMixFilter = null;
	private bool? playedFilter = null;
	private bool? storedFilter = null;
	private bool? wantedFilter = null;

	async Task HandleSaveAsync(SongUpdateDto dto)
	{
		
		var songDto = new SongDto
		{
			Title = dto.Title,
			Length = dto.Length,
			Genre = dto.Genre,
			ExtendedMix = dto.ExtendedMix,
			Favorite = dto.Favorite,
			Played = dto.Played,
			PlayedInEp = dto.PlayedInEp,
			Stored = dto.Stored,
			Wanted = dto.Wanted,
			WantedSongUrl = dto.WantedSongUrl,
			ArtistIds = dto.ArtistIds,
			RemixArtistIds = dto.RemixArtistIds
		};

		await SongService.UpdateSongByIdAsync(dto.SongId, songDto);
	}


	public enum SongFilterType
	{
		Played,
		Stored,
		Wanted, 
		ExtendedMix,
		Favorite
	}

	private void SelectSong(Song song)
	{

		if(selectedSong?.SongId == song.SongId)
		{
			selectedSong = null;
			isSelected = false;
		}

		else
		{
			selectedSong = song;
			isSelected = true;
		}
	}

	private void ToggleEditModal()
	{
		editModalVisible = !editModalVisible;
	}

	private void ToggleEmptyDbModal()
	{
		emptyDbModalVisible = !emptyDbModalVisible;

	}

	private void ToggleDeleteModal()
	{
		deleteModalVisible = !deleteModalVisible;
	}

	private async Task OnSearchInputChanged(ChangeEventArgs e)
	{
		searchString = e.Value?.ToString() ?? "";
		await LoadFilteredSongsAsync();
	}

	protected override async Task OnInitializedAsync()
	{

		await Task.Delay(300);

		songs = await SongService.GetAllSongsAsync();

		if (songs?.Value == null || !songs.Value.Any())
		{
			emptyDbModalVisible = true;
		}
	}

	private async Task LoadFilteredSongsAsync()
	{
		var result = await SongService.GetAllSongsWithFiltersAsync(
			ExtendedMix: extendedMixFilter,
			RadioMix: null,
			Favorite: favoriteFilter,
			Played: playedFilter,
			Stored: storedFilter,
			Wanted: wantedFilter
		);

		isFiltering = true;

		IEnumerable<Song> filtered = result.IsSuccess ? result.Value : Enumerable.Empty<Song>();

		if (!string.IsNullOrWhiteSpace(searchString))
		{
			string lowerSearch = searchString.ToLower();

			filtered = filtered.Where(song =>
				(song.Title?.ToLower().Contains(lowerSearch) ?? false) ||
				(song.RemixArtist?.ToLower().Contains(lowerSearch) ?? false) ||
				(song.Artists != null && song.Artists.Any(a => a.Name.ToLower().Contains(lowerSearch)))
			);
		}

		filteredSongs = filtered.ToList();

		emptyDbModalVisible = !filteredSongs.Any();
	}

	private async Task SetTableFilters(SongFilterType filterType, bool isChecked)
	{
		switch (filterType)
		{
			case SongFilterType.Played:
				playedFilter = isChecked ? true : null;
				break;

			case SongFilterType.Stored:
				storedFilter = isChecked ? true : null;
				break;

			case SongFilterType.Wanted:
				wantedFilter = isChecked ? true : null;
				break;

			case SongFilterType.Favorite:
				favoriteFilter = isChecked ? true : null;
				break;

			case SongFilterType.ExtendedMix:
				extendedMixFilter = isChecked ? true : null;
				break;
		}

		
		if (isChecked)
		{
			
			ToastService.ShowToast(filterType switch
			{
				SongFilterType.Played => "INFO: Viser avspilte låter.",
				SongFilterType.Stored => "INFO: Viser lagrede låter.",
				SongFilterType.Wanted => "INFO: Viser ønskede låter.",
				SongFilterType.Favorite => "INFO: Viser favorittlåter.",
				SongFilterType.ExtendedMix => "INFO: Viser extended mixes.",
				_ => "Filter aktivert."
			}, ToastType.Info);
		}
		else
		{
			
			if (playedFilter is null &&
				storedFilter is null &&
				wantedFilter is null &&
				favoriteFilter is null &&
				extendedMixFilter is null)
			{
				ToastService.ShowToast("INFO: Filtrering er deaktivert.", ToastType.Info);
			}
		}

		await LoadFilteredSongsAsync();
	}

	private async Task OnSongEdited(Song updatedSong)
	{

		var dto = new RMD.Data.Models.DTO.SongDto
			{
				Title = updatedSong.Title,
				ArtistIds = updatedSong.Artists?.Select(a => a.ArtistId).ToList() ?? new List<int>(),
				RemixArtist = updatedSong.RemixArtist,
				Length = updatedSong.Length,
				Genre = updatedSong.Genre,
				ExtendedMix = updatedSong.ExtendedMix,
				RadioMix = updatedSong.RadioMix,
				Favorite = updatedSong.Favorite,
				Played = updatedSong.Played,
				PlayedInEp = updatedSong.PlayedInEp,
				Stored = updatedSong.Stored,
				Wanted = updatedSong.Wanted,
				WantedSongUrl = updatedSong.WantedSongUrl
			};

		var result = await SongService.UpdateSongByIdAsync(updatedSong.SongId, dto);

		if (result.IsSuccess)
		{
			// Reload songs, setting relevant flags to false
			songs = await SongService.GetAllSongsAsync();
			isSelected = false;
			editModalVisible = false;
		}
		else
		{
			if (!result.IsSuccess)
			{
				ToastService.ShowToast("FEIL: Kunne ikke oppdatere låten: " + result.Error, ToastType.Error);
			}
		}
	}

	private async Task OnSongDeleted(Song selectedSong)
	{
		var result = await SongService.DeleteSongByIdAsync(selectedSong.SongId);

		if (result.IsSuccess)
		{
			songs = await SongService.GetAllSongsAsync();

			if (isFiltering)
			{
				await LoadFilteredSongsAsync();
			}

			isSelected = false;
			deleteModalVisible = false;
		}
		else
		{
			ToastService.ShowToast("FEIL : En ukjent feil har oppstått. Prøv igjen senere.", ToastType.Error);
		}
	}
}
