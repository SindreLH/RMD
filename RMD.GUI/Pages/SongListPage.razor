@page "/Songs"
@attribute [Authorize]
@using RMD.GUI.Pages.Components.Modals;
@using RMD.Data.Models;
@using RMD.Data.Models.DTO;
@using RMD.Business.Services
@inject ISongService SongService
@inject ToastService ToastService

<PageTitle>RMD | Låter</PageTitle>

@if (editModalVisible)
{
	<EditSongModal IsVisible="editModalVisible"
				   OnClose="@ToggleEditModal"
				   Song="selectedSong"
				   OnSave="HandleSaveAsync"
				   @key="selectedSong?.SongId" />
}

@if (deleteModalVisible)
{
	<WarningModalSongDeletion IsVisible="deleteModalVisible"
		OnClose="ToggleDeleteModal"
		Song="selectedSong"
		OnDelete="OnSongDeleted" />
}

@if (emptyDbModalVisible)
{
	<ErrorModalEmptyDb IsVisible="true" OnClose="ToggleEmptyDbModal" />
}

<div class="rmd-page">
	<div class="rmd-toolbar">
		<input type="search"
			   class="form-control rmd-search"
			   placeholder="Søk etter låt eller artist"
			   aria-label="Søk etter låt eller artist"
			   value="@searchString"
			   @oninput="OnSearchInputChanged" />

		<div class="rmd-cluster" role="group" aria-label="Filtre">
			<div class="form-check form-check-inline m-0">
				<input class="form-check-input" type="checkbox" id="playedFilter" @onchange="e => SetTableFilters(SongFilterType.Played, e.Value is true)" />
				<label class="form-check-label" for="playedFilter">Avspilt</label>
			</div>

			<div class="form-check form-check-inline m-0">
				<input class="form-check-input" type="checkbox" id="storedFilter" @onchange="e => SetTableFilters(SongFilterType.Stored, e.Value is true)" />
				<label class="form-check-label" for="storedFilter">Lagret</label>
			</div>

			<div class="form-check form-check-inline m-0">
				<input class="form-check-input" type="checkbox" id="wantedFilter" @onchange="e => SetTableFilters(SongFilterType.Wanted, e.Value is true)" />
				<label class="form-check-label" for="wantedFilter">Ønsket</label>
			</div>

			<div class="form-check form-check-inline m-0">
				<input class="form-check-input" type="checkbox" id="extendedMixFilter" @onchange="e => SetTableFilters(SongFilterType.ExtendedMix, e.Value is true)" />
				<label class="form-check-label" for="extendedMixFilter">Extended Mix</label>
			</div>

			<div class="form-check form-check-inline m-0">
				<input class="form-check-input" type="checkbox" id="favoriteFilter" @onchange="e => SetTableFilters(SongFilterType.Favorite, e.Value is true)" />
				<label class="form-check-label" for="favoriteFilter">Favoritt</label>
			</div>
		</div>

		@if (isSelected)
		{
			<div class="rmd-toolbar__actions">
				<button type="button" @onclick="ToggleEditModal" class="btn btn-warning">
					<i class="bi bi-pencil"></i> Rediger låt
				</button>
				<button type="button" @onclick="ToggleDeleteModal" class="btn btn-danger">
					<i class="bi bi-trash3"></i> Fjern låt
				</button>
			</div>
		}
	</div>

	@if (loadError != null)
	{
		<p class="text-danger">@loadError</p>
	}

	@if (!isLoaded)
	{
		<div class="rmd-loader">
			<img src="/images/Loader.gif" alt="" />
			<p>Laster inn låter...</p>
		</div>
	}
	else if (allSongs.Count > 0 && !VisibleSongs.Any())
	{
		<div class="rmd-empty">
			<p>Ingen låter matcher søket eller filtrene.</p>
		</div>
	}
	else if (allSongs.Count > 0)
	{
		<p class="rmd-muted m-0 d-md-none">Trykk på en låt for å redigere eller slette den.</p>

		<div class="rmd-table-wrap songs-table">
			<table class="table table-bordered table-dark table-striped table-hover rmd-table rmd-table--stack is-selectable">
				<thead>
					<tr>
						<th class="rmd-col-xl">#</th>
						<th>Tittel</th>
						<th>Artister</th>
						<th class="rmd-col-lg">Remixer</th>
						<th>Lengde</th>
						<th class="rmd-col-lg">Sjanger</th>
						<th class="rmd-col-xl">EP</th>
						<th>URL</th>
						<th class="rmd-col-xl">Extended</th>
						<th>Favoritt</th>
						<th class="rmd-col-lg">Lagret</th>
					</tr>
				</thead>

				<tbody>
					@foreach (var song in VisibleSongs)
					{
						var remixNames = ArtistNames(song, ArtistRole.Remix);
						var artistNames = ArtistNames(song, ArtistRole.Primary);
						var songUrl = SafeUrl.ForHref(song.WantedSongUrl);

						<tr @onclick="() => SelectSong(song)"
							class="@(selectedSong?.SongId == song.SongId ? "selected-row" : "")"
							aria-selected="@(selectedSong?.SongId == song.SongId ? "true" : "false")">
							<td class="rmd-col-xl rmd-hide-stack" data-label="#">@song.SongId</td>
							<td class="rmd-cell-title rmd-truncate" style="--rmd-truncate-max: 22rem" title="@song.Title">@song.Title</td>
							<td class="rmd-truncate" style="--rmd-truncate-max: 14rem" title="@artistNames" data-label="Artister">
								@if (artistNames.Length > 0)
								{
									@artistNames
								}
								else
								{
									<em>Ingen artister</em>
								}
							</td>
							<td class="rmd-col-lg rmd-truncate" style="--rmd-truncate-max: 14rem" title="@remixNames" data-label="Remix">@remixNames</td>
							<td data-label="Lengde">@song.Length</td>
							<td class="rmd-col-lg" data-label="Sjanger">@song.Genre</td>
							<td class="rmd-col-xl" data-label="Spilt i EP">@song.PlayedInEp</td>
							<td data-label="Kilde">@if (songUrl != null)
								{
									<a href="@songUrl" target="_blank" rel="noopener noreferrer" title="@songUrl"
									   @onclick:stopPropagation="true">🔗</a>
								}</td>
							<td class="rmd-col-xl" data-label="Extended">@(song.ExtendedMix ? "✅" : "❌")</td>
							<td data-label="Favoritt">@(song.Favorite ? "⭐" : "❌")</td>
							<td class="rmd-col-lg" data-label="Lagret">@(song.Stored ? "✅" : "❌")</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
</div>


@code {
	private List<Song> allSongs = new();
	private bool isLoaded;
	private string? loadError;

	private bool isSelected = false;
	private bool editModalVisible = false;
	private bool deleteModalVisible = false;
	private bool emptyDbModalVisible = false;

	private Song? selectedSong;
	private string searchString = string.Empty;
	private bool? favoriteFilter = null;
	private bool? extendedMixFilter = null;
	private bool? playedFilter = null;
	private bool? storedFilter = null;
	private bool? wantedFilter = null;

	public enum SongFilterType
	{
		Played,
		Stored,
		Wanted,
		ExtendedMix,
		Favorite
	}

	/// <summary>The loaded songs with the search text and checkbox filters applied (in memory, no database call).</summary>
	private IEnumerable<Song> VisibleSongs => allSongs
		.Where(x => !extendedMixFilter.HasValue || x.ExtendedMix == extendedMixFilter.Value)
		.Where(x => !favoriteFilter.HasValue || x.Favorite == favoriteFilter.Value)
		.Where(x => !playedFilter.HasValue || x.Played == playedFilter.Value)
		.Where(x => !storedFilter.HasValue || x.Stored == storedFilter.Value)
		.Where(x => !wantedFilter.HasValue || x.Wanted == wantedFilter.Value)
		.Where(MatchesSearch);

	private bool MatchesSearch(Song song)
	{
		if (string.IsNullOrWhiteSpace(searchString))
			return true;

		var term = searchString.Trim();
		return song.Title.Contains(term, StringComparison.CurrentCultureIgnoreCase)
			|| (song.RemixArtist?.Contains(term, StringComparison.CurrentCultureIgnoreCase) ?? false)
			|| song.SongArtists.Any(sa => sa.Artist?.Name.Contains(term, StringComparison.CurrentCultureIgnoreCase) ?? false);
	}

	private static string ArtistNames(Song song, ArtistRole role) => string.Join(", ",
		song.SongArtists
			.Where(sa => sa.Role == role && sa.Artist != null)
			.Select(sa => sa.Artist.Name));

	protected override async Task OnInitializedAsync()
	{
		await LoadSongsAsync();

		if (allSongs.Count == 0 && loadError == null)
		{
			emptyDbModalVisible = true;
		}
	}

	private async Task LoadSongsAsync()
	{
		var result = await SongService.GetAllSongsAsync();

		// "No songs" is reported as a failure by the service; only show real errors
		allSongs = result.IsSuccess ? result.Value.ToList() : new();
		loadError = result.IsSuccess || result.Error.StartsWith("No songs") ? null : "FEIL: Kunne ikke hente låter.";
		isLoaded = true;

		// Keep the selection pointing at fresh data
		if (selectedSong != null)
		{
			selectedSong = allSongs.FirstOrDefault(s => s.SongId == selectedSong.SongId);
			isSelected = selectedSong != null;
		}
	}

	async Task HandleSaveAsync(SongUpdateDto dto)
	{

		var songDto = new SongDto
		{
			Title = dto.Title,
			Length = dto.Length,
			Genre = dto.Genre,
			ExtendedMix = dto.ExtendedMix,
			RadioMix = dto.RadioMix,
			Favorite = dto.Favorite,
			Played = dto.Played,
			PlayedInEp = dto.PlayedInEp,
			Stored = dto.Stored,
			Wanted = dto.Wanted,
			WantedSongUrl = dto.WantedSongUrl,
			ArtistIds = dto.ArtistIds,
			RemixArtistIds = dto.RemixArtistIds
		};

		var result = await SongService.UpdateSongByIdAsync(dto.SongId, songDto);

		if (!result.IsSuccess)
		{
			ToastService.ShowToast("FEIL: Kunne ikke oppdatere låten. " + result.Error, ToastType.Error);
			return;
		}

		ToastService.ShowToast($"SUKSESS! {Shorten(songDto.Title)} ble endret.", ToastType.Success);
		editModalVisible = false;
		await LoadSongsAsync();
	}

	private void SelectSong(Song song)
	{

		if(selectedSong?.SongId == song.SongId)
		{
			selectedSong = null;
			isSelected = false;
		}

		else
		{
			selectedSong = song;
			isSelected = true;

		}
	}

	private async Task ToggleEditModal()
	{
		if (!editModalVisible && selectedSong != null)
		{
			// Hent sangen på nytt med alle relasjoner før modalen åpnes
			var result = await SongService.GetSongByIdWithArtistsAsync(selectedSong.SongId);
			if (!result.IsSuccess)
			{
				ToastService.ShowToast("FEIL: Kunne ikke hente låten.", ToastType.Error);
				return;
			}

			selectedSong = result.Value;
		}
		editModalVisible = !editModalVisible;
	}

	private void ToggleEmptyDbModal()
	{
		emptyDbModalVisible = !emptyDbModalVisible;

	}

	private async Task ToggleDeleteModal()
	{
		if (!deleteModalVisible)
		{

			if (selectedSong == null)
				return;

			var result = await SongService.GetSongByIdWithArtistsAsync(selectedSong.SongId);

			if (!result.IsSuccess)
			{
				ToastService.ShowToast(
			   "FEIL: Kunne ikke hente sangens artister.",
			   ToastType.Error);
				return;
			}

			selectedSong = result.Value;
		}

		deleteModalVisible = !deleteModalVisible;
	}

	private void OnSearchInputChanged(ChangeEventArgs e)
	{
		searchString = e.Value?.ToString() ?? "";
	}

	private void SetTableFilters(SongFilterType filterType, bool isChecked)
	{
		switch (filterType)
		{
			case SongFilterType.Played:
				playedFilter = isChecked ? true : null;
				break;

			case SongFilterType.Stored:
				storedFilter = isChecked ? true : null;
				break;

			case SongFilterType.Wanted:
				wantedFilter = isChecked ? true : null;
				break;

			case SongFilterType.Favorite:
				favoriteFilter = isChecked ? true : null;
				break;

			case SongFilterType.ExtendedMix:
				extendedMixFilter = isChecked ? true : null;
				break;
		}


		if (isChecked)
		{

			ToastService.ShowToast(filterType switch
			{
				SongFilterType.Played => "INFO: Viser avspilte låter.",
				SongFilterType.Stored => "INFO: Viser lagrede låter.",
				SongFilterType.Wanted => "INFO: Viser ønskede låter.",
				SongFilterType.Favorite => "INFO: Viser favorittlåter.",
				SongFilterType.ExtendedMix => "INFO: Viser extended mixes.",
				_ => "Filter aktivert."
			}, ToastType.Info);
		}
		else
		{

			if (playedFilter is null &&
				storedFilter is null &&
				wantedFilter is null &&
				favoriteFilter is null &&
				extendedMixFilter is null)
			{
				ToastService.ShowToast("INFO: Filtrering er deaktivert.", ToastType.Info);
			}
		}
	}

	private async Task OnSongDeleted(Song songToDelete)
	{
		var result = await SongService.DeleteSongByIdAsync(songToDelete.SongId);

		if (result.IsSuccess)
		{
			ToastService.ShowToast($"SUKSESS! {Shorten(songToDelete.Title)} ble fjernet.", ToastType.Success);
			selectedSong = null;
			isSelected = false;
			deleteModalVisible = false;
			await LoadSongsAsync();
		}
		else
		{
			ToastService.ShowToast("FEIL : En ukjent feil har oppstått. Prøv igjen senere.", ToastType.Error);
		}
	}

	private static string Shorten(string title) => title.Length > 20 ? title[..20] + "..." : title;
}
