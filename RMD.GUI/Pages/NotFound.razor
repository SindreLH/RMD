@layout AuthLayout
@page "/notfound"
@attribute [AllowAnonymous]

<div class="notfound_container">
    <h1 style="color: var(--rmd-text);">404</h1>
    <h3 style="color: var(--rmd-text);">Fant ikke siden</h3>

    <p style="color: var(--rmd-text);">
        Siden du prøvde å nå finnes ikke, eller er flyttet.
    </p>
</div>
