@page "/Artists"
@using RMD.Business.Services
@using RMD.Data.Models
@using RMD.GUI.Pages.Components.Modals
@inject IArtistService ArtistService

<PageTitle>RMD | Artists</PageTitle>

<div class="search-button-wrapper">

	<div class="input-group mb-3 searchbar">
		<input type="text" class="form-control search" placeholder="Søk etter artist" aria-label="Søk etter artist">
		<span class="input-group-text" id="basic-addon2">
			<i class="bi bi-search"></i>
		</span>
	</div>
</div>


<div class="grid_container">
@foreach (var artist in artists?.Value ?? Enumerable.Empty<Artist>())
{
	<div class="artist_card">
		<img src="@artist.ProfilePicUrl"
		alt="Artist Press Picture"
		class="artist_profile_pic" />
		<h3>@artist.Name</h3>
	</div>
}
</div>

@code {
	private bool isSelected = false;
	private bool emptyDbModalVisible = false;
	private Result<IEnumerable<Artist>>? artists;

	protected override async Task OnInitializedAsync()
	{
		artists = await ArtistService.GetAllArtistsAsync();

		if (artists?.Value == null || !artists.Value.Any())
		{
			emptyDbModalVisible = true;
		}
	}

}
