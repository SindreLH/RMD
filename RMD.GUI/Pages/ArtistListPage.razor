@page "/Artists"
@using RMD.Business.Services
@using RMD.Data.Models
@using RMD.GUI.Pages.Components.Modals
@inject IArtistService ArtistService

<PageTitle>RMD | Artists</PageTitle>

@if (emptyDbModalVisible)
{
	<ErrorModalEmptyDb IsVisible="true" OnClose="ToggleEmptyDbModal" />
}

<div class="search-button-wrapper">

	<div class="input-group mb-3 searchbar">
		<input 
		type="text"
		class="form-control search" 
		placeholder="Søk etter artist" 
		aria-label="Søk etter artist"
		value="@searchString"
		@oninput="OnSearchInputChanged"/>
	</div>


	<div class="checkboxes">
		<div class="form-check form-check-inline">
			<input class="form-check-input" type="checkbox" id="alphabetical"
			@bind="sortAlphabetically" />
			<label class="form-check-label" for="alphabetical">Alfabetisk</label>
		</div>
	</div>
</div>

@if (emptyDbModalVisible)
{
	<ErrorModalEmptyDb IsVisible="true" OnClose="ToggleEmptyDbModal" />
}

<div class="grid_container">
	@foreach (var artist in (isFiltering ? filteredArtists : artists?.Value ?? Enumerable.Empty<Artist>()))
	{	
		<a href="/Artist/@artist.ArtistId">
			<div class="artist_card">
				@if(string.IsNullOrWhiteSpace(artist.ProfilePicUrl))
				{
					<img src="images/no_artist_image.png"
					alt="Default artist icon"
					class="artist_profile_pic" />
				}
				else
				{
					<img src="@artist.ProfilePicUrl"
					alt="Artist Press Picture"
					class="artist_profile_pic" />
				}
				<h3 class="text-truncate" style="max-width: 200px" title="@artist.Name">@artist.Name</h3>
			</div>
		</a>
	}
</div>

@if (artists == null)
{
	<div class="load_container">
		<div class="load_contents">
			<img src="/images/Loader.gif" alt="Loading..." class="load_spinner" />
			<p class="load_text">Laster inn alle artister...</p>
		</div>
	</div>
}

@code {
	private Result<IEnumerable<Artist>>? artists;
	private IEnumerable<Artist> filteredArtists = new List<Artist>();
	private IEnumerable<Artist> alphabeticallySorted = new List<Artist>();

	private List<Artist> allArtists = new();

	private bool isSelected = false;
	private bool isFiltering = false;
	private bool emptyDbModalVisible = false;
	private bool sortAlphabetically
	{
		get => _sortAlphabetically;
		set
		{
			if (_sortAlphabetically != value)
			{
				_sortAlphabetically = value;
				_ = UpdateArtistListDisplayAsync();
			}
		}
	}
	private bool _sortAlphabetically;

	private string searchString = string.Empty;

	protected override async Task OnInitializedAsync()
	{
		await Task.Delay(300);

		var result = await ArtistService.GetAllArtistsAsync();

		if (result.IsSuccess)
		{
			allArtists = result.Value.ToList();
			artists = Result<IEnumerable<Artist>>.Success(allArtists);
		}
		else
		{
			artists = Result<IEnumerable<Artist>>.Success(new List<Artist>());
		}


		emptyDbModalVisible = !allArtists.Any();
	}

	private async Task OnSearchInputChanged(ChangeEventArgs e)
	{
		searchString = e.Value?.ToString() ?? "";
		await ApplyFilteringAndSortingAsync();
	}

	private async Task OnSortChanged(ChangeEventArgs e)
	{
		if (sortAlphabetically)
		{
			var result = await ArtistService.GetAllArtistsAsync();
			var baseList = result.IsSuccess ? result.Value : Enumerable.Empty<Artist>();

			if (isFiltering)
			{
				filteredArtists = filteredArtists.OrderBy(a => a.Name).ToList();
			}
			else
			{
				artists = Result<IEnumerable<Artist>>.Success(baseList.OrderBy(a => a.Name).ToList());
			}
		}
		else
		{
			artists = await ArtistService.GetAllArtistsAsync();
			if (isFiltering)
			{
				await ApplyFilteringAndSortingAsync();
			}
		}
	}

	private async Task ApplyFilteringAndSortingAsync()
	{
		var result = await ArtistService.GetAllArtistsAsync();
		var baseList = result.IsSuccess ? result.Value : Enumerable.Empty<Artist>();

		bool hasFilter = !string.IsNullOrWhiteSpace(searchString);
		isFiltering = hasFilter;

		if (hasFilter)
		{
			string lowerSearch = searchString.ToLower();
			baseList = baseList.Where(artist =>
				artist.Name?.ToLower().Contains(lowerSearch) ?? false
			);
		}

		if (sortAlphabetically)
		{
			baseList = baseList.OrderBy(a => a.Name);
		}

		var finalList = baseList.ToList();
		emptyDbModalVisible = !finalList.Any();

		if (isFiltering)
		{
			filteredArtists = finalList;
		}
		else
		{
			artists = Result<IEnumerable<Artist>>.Success(finalList);
		}
	}

	private void ToggleEmptyDbModal()
	{
		emptyDbModalVisible = !emptyDbModalVisible;

	}

	private async Task UpdateArtistListDisplayAsync()
	{
		if (!sortAlphabetically)
		{
			// Reset everything to the original list
			isFiltering = false;
			filteredArtists = new List<Artist>();
			artists = Result<IEnumerable<Artist>>.Success(allArtists);
			emptyDbModalVisible = !allArtists.Any();
			return;
		}

		// If sorting is enabled, apply filtering (if any), and sort alphabetically
		isFiltering = !string.IsNullOrWhiteSpace(searchString);
		IEnumerable<Artist> baseList = allArtists;

		if (isFiltering)
		{
			string lowerSearch = searchString.ToLower();
			baseList = baseList.Where(artist =>
				artist.Name?.ToLower().Contains(lowerSearch) ?? false
			);
		}

		var sorted = baseList.OrderBy(a => a.Name).ToList();
		emptyDbModalVisible = !sorted.Any();

		if (isFiltering)
		{
			filteredArtists = sorted;
		}
		else
		{
			artists = Result<IEnumerable<Artist>>.Success(sorted);
		}
	}
	
}
