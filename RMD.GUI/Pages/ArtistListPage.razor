@page "/Artists"
@attribute [Authorize]
@using RMD.Business.Services
@using RMD.Data.Models
@using RMD.GUI.Pages.Components.Modals
@using RMD.GUI.Pages.Components.Toasts

@inject ToastService ToastService
@inject IArtistService ArtistService

<PageTitle>RMD | Artister</PageTitle>

@if (emptyDbModalVisible)
{
	<ErrorModalEmptyDb IsVisible="true" OnClose="ToggleEmptyDbModal" />
}

<div class="rmd-page">
	<div class="rmd-toolbar">
		<input type="search"
			   class="form-control rmd-search"
			   placeholder="Søk etter artist"
			   aria-label="Søk etter artist"
			   value="@searchString"
			   @oninput="OnSearchInputChanged" />

		<div class="form-check form-check-inline m-0">
			<input class="form-check-input" type="checkbox" id="alphabetical" @bind="sortAlphabetically" />
			<label class="form-check-label" for="alphabetical">Alfabetisk</label>
		</div>
	</div>

	@if (!isLoaded)
	{
		<div class="rmd-loader">
			<img src="/images/Loader.gif" alt="" />
			<p>Laster inn artister...</p>
		</div>
	}
	else if (allArtists.Count > 0 && !VisibleArtists.Any())
	{
		<div class="rmd-empty">
			<p>Ingen artister matcher "@searchString".</p>
		</div>
	}
	else if (allArtists.Count > 0)
	{
		<div class="rmd-card-grid artist-grid">
			@foreach (var artist in VisibleArtists)
			{
				var picture = SafeUrl.ForHref(artist.ProfilePicUrl) ?? "images/no_artist_image.png";
				<a href="/Artist/@artist.ArtistId" class="artist-card">
					<img src="@picture" alt="" class="artist-card__pic" loading="lazy" />
					<span class="artist-card__name" title="@artist.Name">@artist.Name</span>
				</a>
			}
		</div>
	}
</div>

@code {
	private List<Artist> allArtists = new();
	private bool isLoaded;

	private bool emptyDbModalVisible = false;
	private bool sortAlphabetically
	{
		get => _sortAlphabetically;
		set
		{
			if (_sortAlphabetically != value)
			{
				_sortAlphabetically = value;
				ToastService.ShowToast(value
					? "INFO: Alfabetisk sortering aktivert."
					: "INFO: Kronologisk sortering aktivert.", ToastType.Info);
			}
		}
	}
	private bool _sortAlphabetically;

	private string searchString = string.Empty;

	/// <summary>The loaded artists with search and sorting applied in memory (no database call per keystroke).</summary>
	private IEnumerable<Artist> VisibleArtists
	{
		get
		{
			IEnumerable<Artist> list = allArtists;

			if (!string.IsNullOrWhiteSpace(searchString))
				list = list.Where(a => a.Name.Contains(searchString.Trim(), StringComparison.CurrentCultureIgnoreCase));

			return sortAlphabetically
				? list.OrderBy(a => a.Name, StringComparer.CurrentCultureIgnoreCase)
				: list;
		}
	}

	protected override async Task OnInitializedAsync()
	{
		var result = await ArtistService.GetAllArtistsAsync();

		allArtists = result.IsSuccess ? result.Value.ToList() : new();
		isLoaded = true;

		emptyDbModalVisible = !allArtists.Any();
	}

	private void OnSearchInputChanged(ChangeEventArgs e)
	{
		searchString = e.Value?.ToString() ?? "";
	}

	private void ToggleEmptyDbModal()
	{
		emptyDbModalVisible = !emptyDbModalVisible;

	}
}
