@using RMD.Business.Services
@using RMD.Data.Models
@using Microsoft.AspNetCore.Identity
@using System.ComponentModel.DataAnnotations

@page "/ForgotPassword"
@attribute [AllowAnonymous]
@layout AuthLayout

@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Nav
@inject ToastService ToastService

<div class="main_container">
	
@if (!emailSent)
	{
		<div class="form_container">
			<h1 style="color: white;">Glemt passord?</h1>
			<form method="post" action="/auth/ForgotPassword" class="form_contents">
				<AntiforgeryInput />
				<div class="email_field">
					<input type="email" name="Email" class="form-control" placeholder="epost@eksempel.no" required />
				</div>
				
				<button type="submit" class="btn btn-success">Send lenke</button>
			</form>
		</div>
	}
	
	
	else
	{
		<h2 style="color: white;">Reset av brukerpassord er iverksatt</h2>
		<p style="color: white">En reset-lenke blir sendt via e-post om du har oppgitt gyldig e-postadresse.</p>
		<p style="color: white">Åpne e-posten og følg instruksjonene.</p>
		<a href="/login" style="color: white">Tilbake til innlogging</a>
	}

</div>


@code{
	bool emailSent;

	public ForgotPasswordModel model = new();

	protected override void OnInitialized()
	{
		var uri = Nav.ToAbsoluteUri(Nav.Uri);
		var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
		emailSent = query["sent"] == "true";
	}

	public class ForgotPasswordModel
	{
		[Required]
		[EmailAddress]
		public string Email { get; set; } = "";
	}

	
}