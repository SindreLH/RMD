@using RMD.Data.Models
@using System.ComponentModel.DataAnnotations

@page "/ForgotPassword"
@attribute [AllowAnonymous]
@layout AuthLayout

@inject NavigationManager Nav

<PageTitle>RMD | Glemt passord</PageTitle>

<div class="rmd-auth-card">
	@if (!emailSent)
	{
		<h1>Glemt passord?</h1>
		<p class="text-center">Skriv inn e-postadressen din, så sender vi en lenke for å velge nytt passord.</p>

		<form method="post" action="/auth/ForgotPassword" class="d-flex flex-column gap-3">
			<AntiforgeryInput />
			<div class="rmd-field">
				<label for="email">E-post</label>
				<input id="email" type="email" name="Email" class="form-control" placeholder="epost@eksempel.no" autocomplete="email" required />
			</div>

			<button type="submit" class="btn btn-success mt-2">Send lenke</button>
		</form>

		<div class="rmd-auth-row justify-content-center">
			<a href="/login">Tilbake til innlogging</a>
		</div>
	}
	else
	{
		<h1>Sjekk e-posten</h1>
		<p>En reset-lenke blir sendt via e-post om du har oppgitt gyldig e-postadresse.</p>
		<p>Åpne e-posten og følg instruksjonene.</p>
		<a href="/login">Tilbake til innlogging</a>
	}
</div>


@code{
	bool emailSent;

	public ForgotPasswordModel model = new();

	protected override void OnInitialized()
	{
		var uri = Nav.ToAbsoluteUri(Nav.Uri);
		var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
		emailSent = query["sent"] == "true";
	}

	public class ForgotPasswordModel
	{
		[Required]
		[EmailAddress]
		public string Email { get; set; } = "";
	}

	
}